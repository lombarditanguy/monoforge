---
const { title = "Admin" } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: "/admin", label: "Tableau de bord" },
  { href: "/admin/clients", label: "Clients" },
  { href: "/admin/prix", label: "Prix & coefficients" },
  { href: "/admin/factures", label: "Factures" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Admin Kessler Wheels</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <style>
      :root {
        color-scheme: dark;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: #0a0a0b;
        color: #f3f1ec;
        font-family: system-ui, sans-serif;
      }
      .shell {
        display: grid;
        grid-template-columns: 15rem 1fr;
        min-height: 100vh;
      }
      aside {
        border-right: 1px solid #26262b;
        padding: 1.5rem 1rem;
        display: flex;
        flex-direction: column;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 2rem;
        padding: 0 0.5rem;
      }
      .logo img:first-child {
        height: 24px;
        width: 24px;
      }
      .logo img:last-child {
        height: 12px;
        width: auto;
      }
      nav a {
        display: block;
        padding: 0.6rem 0.75rem;
        border-radius: 0.35rem;
        color: #a9a9b2;
        text-decoration: none;
        font-size: 0.9rem;
        margin-bottom: 0.2rem;
      }
      nav a.active,
      nav a:hover {
        background: #1c1c20;
        color: #f3f1ec;
      }
      .spacer {
        flex: 1;
      }
      form.logout button {
        width: 100%;
        padding: 0.55rem;
        border: 1px solid #26262b;
        border-radius: 0.35rem;
        background: transparent;
        color: #a9a9b2;
        cursor: pointer;
        font-size: 0.85rem;
      }
      main {
        padding: 2rem 2.5rem;
        max-width: 72rem;
      }
      h1 {
        font-size: 1.5rem;
        margin: 0 0 1.5rem;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
      }
      th,
      td {
        text-align: left;
        padding: 0.6rem 0.75rem;
        border-bottom: 1px solid #1c1c20;
      }
      th {
        color: #a9a9b2;
        font-weight: 600;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }
      .card {
        border: 1px solid #26262b;
        border-radius: 0.5rem;
        background: #131316;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
      }
      .btn {
        display: inline-block;
        padding: 0.6rem 1.1rem;
        border-radius: 0.35rem;
        background: #ff5a1f;
        color: #0a0a0b;
        font-weight: 700;
        font-size: 0.85rem;
        text-decoration: none;
        border: none;
        cursor: pointer;
      }
      .btn-outline {
        background: transparent;
        border: 1px solid #26262b;
        color: #f3f1ec;
      }
      label {
        display: block;
        font-size: 0.82rem;
        color: #a9a9b2;
        margin-bottom: 0.3rem;
      }
      input,
      select,
      textarea {
        width: 100%;
        padding: 0.55rem 0.75rem;
        border-radius: 0.35rem;
        border: 1px solid #26262b;
        background: #1c1c20;
        color: #f3f1ec;
        font-size: 0.9rem;
        margin-bottom: 1rem;
        font-family: inherit;
      }
      .field-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
        gap: 1rem;
      }
      .notice {
        border: 1px solid #ff5a1f55;
        background: #ff5a1f14;
        border-radius: 0.35rem;
        padding: 0.9rem 1rem;
        font-size: 0.85rem;
        margin-bottom: 1.5rem;
      }
      .muted {
        color: #a9a9b2;
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <aside>
        <div class="logo">
          <img src="/logo-icon.png" alt="" />
          <img src="/logo-text.png" alt="Kessler Wheels" />
        </div>
        <nav>
          {nav.map((item) => (
            <a href={item.href} class:list={[path === item.href && "active"]}>{item.label}</a>
          ))}
        </nav>
        <div class="spacer"></div>
        <form class="logout" method="POST" action="/api/admin/logout">
          <button type="submit">Se déconnecter</button>
        </form>
      </aside>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
