---
// Vignette du catalogue.
//
// Le pied ne portait qu'une ligne : le prix, centré et en gras, seul au milieu
// de la carte. Une référence sans nom et un prix centré, c'est l'étiquette d'un
// bac de promotion, pas la fiche d'une jante forgée à la commande. Deux choses
// le corrigent, et elles ne coûtent aucune place :
//
//   * la référence est affichée. Sans elle les douze vignettes sont anonymes et
//     interchangeables — or c'est le code que le client note, cherche et
//     redemande ;
//   * « à partir de » et le montant ne pèsent plus pareil. La mention est une
//     réserve, le montant est l'information : au même corps et à la même
//     graisse ils se valaient, et c'est ce qui faisait bon marché.
//
// Aligné à gauche, comme la référence : l'œil descend une colonne au lieu de
// zigzaguer entre douze centres.
interface Props { item: any; startingPrice?: number; tendance?: string; argument?: string }
const { item, startingPrice = 0, tendance = "", argument = "" } = Astro.props;
// Séparateur de milliers à la française. « 1811 € » se lit comme un nombre de
// série, « 1 811 € » comme un prix — et au-dessus de mille euros c'est presque
// tout le catalogue.
const prix = startingPrice > 0 ? Math.round(startingPrice).toLocaleString("fr-FR") : null;
---

<a
  href={`/catalogue/${item.family}/${item.slug}`}
  data-wheel-code={item.code.toLowerCase()}
  data-wheel-style={item.spokeStyle || ""}
  class="wheel-card group block overflow-hidden rounded-lg border border-(--color-line) bg-(--color-surface) transition-all duration-300 hover:-translate-y-1 hover:border-(--color-forge-500)/60 hover:shadow-[0_16px_32px_-12px_rgba(0,0,0,0.55)]"
>
  <div class="relative aspect-square overflow-hidden bg-(--color-surface-2)">
    <img
      src={item.image}
      alt={`Jante forgée ${item.code}`}
      loading="lazy"
      width="300"
      height="300"
      class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.06]"
    />
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-14 bg-gradient-to-t from-(--color-ink)/90 to-transparent opacity-0 transition-opacity duration-200 group-hover:opacity-100"></div>
    <span class="pointer-events-none absolute bottom-2.5 left-1/2 flex -translate-x-1/2 items-center gap-1 text-xs font-semibold text-(--color-forge-400) opacity-0 transition-opacity duration-200 group-hover:opacity-100">
      Voir la fiche
      <svg width="10" height="10" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7H13M13 7L8 2M13 7L8 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </span>
    {tendance && <span class="chip absolute left-3 top-3 bg-(--color-ink)/80">{tendance}</span>}
  </div>

  <div class="border-t border-(--color-line)/60 px-3.5 pb-3 pt-2.5">
    <p class="mf-carte-ref">{item.code}</p>
    {prix ? (
      <p class="mt-[.45rem] flex items-baseline gap-1.5">
        <span class="text-[0.68rem] leading-none text-(--color-fog)">à partir de</span>
        <span class="font-display text-[1.05rem] leading-none font-bold text-(--color-paper)">{prix}&nbsp;€</span>
      </p>
    ) : (
      <p class="mt-[.45rem] text-[0.88rem] leading-none font-semibold text-(--color-mist)">Sur devis</p>
    )}
  </div>

  {argument && <p class="px-3.5 pb-3.5 text-xs leading-relaxed text-(--color-mist)">{argument}</p>}
</a>

<style>
  /* La référence en chasse fixe : c'est un code, pas un nom. Lue comme une
     donnée technique, elle n'entre pas en concurrence avec le prix. */
  .mf-carte-ref {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-fog);
    line-height: 1;
  }
</style>
