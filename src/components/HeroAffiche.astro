---
// Écran d'accueil.
//
// Trois couches empilées de haut en bas : l'accroche, la photo, le catalogue.
// L'accroche est posée par-dessus le haut de l'image et le catalogue remonte
// par-dessus son bas — les chevauchements sont voulus. Une jante isolée dans
// son propre bandeau laissait un trou entre elle et le reste : on avait
// l'impression d'être devant une page de garde et il fallait défiler pour
// atteindre le site. En serrant les trois couches, le catalogue entre dans le
// premier écran.
//
// L'image occupe la moitié droite et s'arrête à mille pixels. C'est une
// contrainte de définition, pas de mise en page : la photo d'origine fait
// 800 px de large. Étalée sur toute la largeur d'un écran de bureau, elle
// était agrandie deux fois et demie et les rayons devenaient pâteux. Bornée
// ici, elle est réduite jusqu'à 1400 px de fenêtre et agrandie d'un quart au
// plus au-delà — un facteur qui ne se voit pas. Le reste du cadre laisse
// passer le fond animé du site, ce qui donne à la moitié gauche autre chose
// qu'un aplat.
//
// La photo est celle de DZ-169, prise au ras du sol. Sa jumelle DZ-081 est la
// même prise de vue, mais son cache-moyeu porte la marque du fournisseur.
---

<section class="mf-affiche">
  <div class="mf-affiche-media">
    <img
      class="mf-affiche-photo"
      src="/kw-hero.webp"
      srcset="/kw-hero-mobile.webp 760w, /kw-hero.webp 1000w"
      sizes="(max-width: 47.99rem) 100vw, min(56vw, 1000px)"
      alt="Jante forgée montée sur une berline, vue au ras du sol"
      width="1000"
      height="560"
      fetchpriority="high"
    />
  </div>

  <div class="mf-affiche-tete container-mf">
    <h1 class="mf-affiche-titre font-display text-4xl leading-[.96] font-bold tracking-[-.03em] text-balance text-(--color-paper) sm:text-5xl lg:text-6xl">
      Forgée pour une seule voiture&nbsp;: <span class="text-(--color-forge-400)">la vôtre.</span>
    </h1>
    <p class="mf-affiche-specs">
      <span>15″ – 26″</span><span>Tout entraxe</span><span>Déport calculé</span><span>Aluminium 6061-T6</span>
    </p>
  </div>
</section>

<style>
  .mf-affiche {
    position: relative;
    /* Assez pour que la jante respire, assez court pour que les puces du
       catalogue entrent dans le premier écran. Jamais de borne de hauteur avec
       `aspect-ratio` : les deux ensemble élargissent la boîte au lieu de la
       raccourcir, et la section débordait de l'écran. */
    height: clamp(19rem, 52vh, 30rem);
    /* Opaque, pour arrêter le fond animé. Sans ce fond, la moitié gauche du
       bandeau laissait voir la jante qui tourne derrière la photo : deux jantes
       superposées en haut de page, l'une fixe et l'autre en rotation. La vidéo
       ne commence donc qu'en dessous. */
    background: var(--color-ink);
  }
  .mf-affiche-media {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(56%, 1000px);
    overflow: hidden;
  }
  .mf-affiche-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* La jante est légèrement à droite dans le cadre d'origine : ce point
       d'ancrage la garde entière quelle que soit la hauteur du bandeau. */
    object-position: 54% 50%;
  }

  /* Fondu du bord gauche du panneau, pour que la photo n'ait pas de couture
     avec le fond, et voile du bas pour souder le catalogue qui remonte
     dessus. Le rang est indispensable : sans lui, un pseudo-élément et une
     image tous deux positionnés se peignent dans l'ordre du document, donc le
     voile passerait derrière la photo et ne masquerait rien. */
  .mf-affiche-media::before,
  .mf-affiche-media::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }
  .mf-affiche-media::before {
    background: linear-gradient(
      to right,
      var(--color-ink) 0%,
      color-mix(in oklab, var(--color-ink) 55%, transparent) 14%,
      transparent 34%
    );
  }
  .mf-affiche-media::after {
    background:
      linear-gradient(to top, var(--color-ink) 0%, var(--color-ink) 6%, color-mix(in oklab, var(--color-ink) 50%, transparent) 17%, transparent 36%),
      linear-gradient(to bottom, color-mix(in oklab, var(--color-ink) 62%, transparent) 0%, transparent 22%);
  }

  .mf-affiche-tete {
    position: relative;
    z-index: 3;
    padding-top: clamp(0.75rem, 2.5vw, 2rem);
  }
  .mf-affiche-titre { max-width: 34rem; }
  /* Les caractéristiques passent à la ligne plutôt que de filer vers la
     photo : sur une seule ligne, la dernière finissait sur le chrome. */
  .mf-affiche-specs {
    max-width: 25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.6rem;
    margin-top: 0.9rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-mist);
  }

  /* Sur téléphone, pas de colonne : l'écran est trop étroit pour couper en
     deux, la photo passe derrière le texte dans sa version portrait, et le
     voile la couvre entièrement puisque le texte s'étale sur toute la
     largeur. */
  @media (max-width: 47.99rem) {
    .mf-affiche-media { width: 100%; }
    .mf-affiche-photo { object-position: 50% 46%; }
    .mf-affiche-media::before {
      background: linear-gradient(to right, color-mix(in oklab, var(--color-ink) 55%, transparent) 0%, transparent 72%);
    }
    .mf-affiche-media::after {
      background:
        linear-gradient(to top, var(--color-ink) 0%, var(--color-ink) 7%, color-mix(in oklab, var(--color-ink) 55%, transparent) 18%, transparent 38%),
        linear-gradient(to bottom, color-mix(in oklab, var(--color-ink) 88%, transparent) 0%, color-mix(in oklab, var(--color-ink) 62%, transparent) 26%, transparent 50%);
    }
  }
</style>
