---
// Configurateur de couleur pour l'option peinture.
// Trois entrées : les teintes courantes, le nuancier RAL complet, et une
// couleur libre dont on calcule le RAL le plus proche. Ce qui part en
// fabrication est toujours un code RAL — l'aperçu écran n'est qu'indicatif.
import { RAL_COLORS, POPULAR_RAL, FINITIONS_PEINTURE } from "../data/ralColors.js";

const populaires = POPULAR_RAL.map((code) => RAL_COLORS.find((c) => c.ral === code)).filter(Boolean);
---

<div id="mf-color-panel" class="mt-5 hidden rounded-lg border border-(--color-line) bg-(--color-surface) p-5">
  <p class="text-xs uppercase tracking-widest text-(--color-fog)">Peinture</p>

  <fieldset class="mt-4">
    <legend class="mb-2 text-sm text-(--color-mist)">Aspect</legend>
    <div class="flex flex-wrap gap-2">
      {FINITIONS_PEINTURE.map((f, i) => (
        <label class="mf-aspect cursor-pointer rounded-md border border-(--color-line) px-4 py-2 text-sm text-(--color-mist) has-checked:border-(--color-forge-500) has-checked:text-(--color-paper)">
          <input type="radio" name="peintureAspect" value={f.id} checked={i === 0} class="sr-only" />
          {f.label}
        </label>
      ))}
    </div>
  </fieldset>

  <div class="mt-6">
    <div class="flex flex-wrap gap-1 border-b border-(--color-line)">
      <button type="button" data-tab="courantes" class="mf-tab -mb-px border-b-2 border-(--color-forge-500) px-2 py-2 text-[0.78rem] whitespace-nowrap text-(--color-paper)">Couleurs courantes</button>
      <button type="button" data-tab="nuancier" class="mf-tab -mb-px border-b-2 border-transparent px-2 py-2 text-[0.78rem] whitespace-nowrap text-(--color-fog)">Nuancier RAL</button>
      <button type="button" data-tab="libre" class="mf-tab -mb-px border-b-2 border-transparent px-2 py-2 text-[0.78rem] whitespace-nowrap text-(--color-fog)">Couleur personnalisée</button>
    </div>

    <div data-panel="courantes" class="mt-4">
      <div class="grid grid-cols-4 gap-2">
        {populaires.map((c) => (
          <button type="button" class="mf-swatch group rounded-md border border-(--color-line) p-1.5 text-left hover:border-(--color-forge-500)" data-ral={c.ral} data-nom={c.nom} data-hex={c.hex}>
            <span class="block h-10 w-full rounded" style={`background:${c.hex}`}></span>
            <span class="mt-1 block text-center text-[0.7rem] text-(--color-fog)">{c.ral}</span>
          </button>
        ))}
      </div>
    </div>

    <div data-panel="nuancier" class="mt-4 hidden">
      <input type="search" id="mf-ral-search" placeholder="Rechercher un RAL ou un nom (ex : 7016, anthracite)" class="w-full rounded-md border border-(--color-line) bg-(--color-surface-2) px-3 py-2 text-sm text-(--color-paper) placeholder:text-(--color-fog) focus:border-(--color-forge-500) focus:outline-none" />
      <div id="mf-ral-grid" class="mt-3 grid max-h-64 grid-cols-4 gap-2 overflow-y-auto">
        {RAL_COLORS.map((c) => (
          <button type="button" class="mf-swatch mf-ral-item rounded-md border border-(--color-line) p-1.5 text-left hover:border-(--color-forge-500)" data-ral={c.ral} data-nom={c.nom} data-hex={c.hex} data-search={`${c.ral} ${c.nom.toLowerCase()}`}>
            <span class="block h-10 w-full rounded" style={`background:${c.hex}`}></span>
            <span class="mt-1 block text-center text-[0.7rem] text-(--color-fog)">{c.ral}</span>
          </button>
        ))}
      </div>
    </div>

    <div data-panel="libre" class="mt-4 hidden">
      <div class="flex flex-wrap items-start gap-5">
        <div class="shrink-0">
          <canvas id="mf-wheel" width="360" height="360" class="block h-44 w-44 cursor-crosshair touch-none rounded-full"></canvas>
          <label class="mt-3 block">
            <span class="mb-1 block text-[0.7rem] uppercase tracking-widest text-(--color-fog)">Luminosité</span>
            <input type="range" id="mf-wheel-value" min="10" max="100" value="70" class="w-44 accent-(--color-forge-500)" />
          </label>
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-xs leading-relaxed text-(--color-fog)">
            Chaque pastille est une teinte de peinture réelle : sa position donne la nuance, le curseur fait varier
            la clarté. Les zones vides correspondent à des couleurs qu'aucune peinture ne produit — un bleu d'écran,
            par exemple, est bien plus vif que tout ce qui existe en pot.
          </p>
          <label class="mt-4 block">
            <span class="mb-1 block text-[0.7rem] uppercase tracking-widest text-(--color-fog)">Ou saisissez un code couleur</span>
            <input type="text" id="mf-free-hex" value="#8C6239" spellcheck="false" class="w-32 rounded-md border border-(--color-line) bg-(--color-surface-2) px-3 py-2 font-mono text-sm text-(--color-paper) focus:border-(--color-forge-500) focus:outline-none" />
          </label>
          <div id="mf-free-matches" class="mt-4 grid grid-cols-1 gap-2"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-5 flex items-center gap-3 border-t border-(--color-line) pt-4">
    <span id="mf-color-preview" class="h-10 w-10 shrink-0 rounded border border-(--color-line)" style="background:#0A0A0A"></span>
    <div class="min-w-0">
      <p id="mf-color-label" class="truncate font-display text-base font-bold text-(--color-paper)">RAL 9005 — Noir foncé</p>
      <p id="mf-color-note" class="text-xs text-(--color-fog)">Teinte affichée à titre indicatif : un écran ne reproduit pas fidèlement une peinture. C'est la référence RAL qui fait foi en fabrication.</p>
    </div>
  </div>

  <input type="hidden" name="peintureRal" id="mf-hidden-ral" value="9005" />
  <input type="hidden" name="peintureNom" id="mf-hidden-nom" value="Noir foncé" />
  <input type="hidden" name="peintureHex" id="mf-hidden-hex" value="#0A0A0A" />
</div>

<script>
  import { nearestRal, RAL_WHEEL } from "../lib/colorMatch.js";

  const panel = document.getElementById("mf-color-panel");
  if (panel) {
    const preview = document.getElementById("mf-color-preview");
    const label = document.getElementById("mf-color-label");
    const hiddenRal = document.getElementById("mf-hidden-ral") as HTMLInputElement;
    const hiddenNom = document.getElementById("mf-hidden-nom") as HTMLInputElement;
    const hiddenHex = document.getElementById("mf-hidden-hex") as HTMLInputElement;

    function select(ral: string, nom: string, hex: string) {
      if (preview) preview.style.background = hex;
      if (label) label.textContent = `RAL ${ral} — ${nom}`;
      hiddenRal.value = ral;
      hiddenNom.value = nom;
      hiddenHex.value = hex;
      document.querySelectorAll(".mf-swatch").forEach((el) => {
        el.classList.toggle("border-(--color-forge-500)", (el as HTMLElement).dataset.ral === ral);
      });
      panel.dispatchEvent(new CustomEvent("mf:color", { bubbles: true }));
    }

    panel.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>(".mf-swatch");
      if (!btn) return;
      select(btn.dataset.ral || "", btn.dataset.nom || "", btn.dataset.hex || "");
    });

    // Onglets
    panel.querySelectorAll<HTMLElement>(".mf-tab").forEach((tab) => {
      tab.addEventListener("click", () => {
        const name = tab.dataset.tab;
        panel.querySelectorAll<HTMLElement>(".mf-tab").forEach((t) => {
          const on = t === tab;
          t.classList.toggle("border-(--color-forge-500)", on);
          t.classList.toggle("border-transparent", !on);
          t.classList.toggle("text-(--color-paper)", on);
          t.classList.toggle("text-(--color-fog)", !on);
        });
        panel.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => {
          p.classList.toggle("hidden", p.dataset.panel !== name);
        });
      });
    });

    // Recherche dans le nuancier
    const search = document.getElementById("mf-ral-search") as HTMLInputElement | null;
    search?.addEventListener("input", () => {
      const q = search.value.trim().toLowerCase();
      panel.querySelectorAll<HTMLElement>(".mf-ral-item").forEach((el) => {
        el.classList.toggle("hidden", !!q && !(el.dataset.search || "").includes(q));
      });
    });

    // Roue des teintes RAL. Chaque pastille est une couleur réellement
    // fabricable : l'angle porte la nuance, le rayon la saturation, et le
    // curseur choisit la tranche de clarté affichée. Un dégradé continu
    // laissait choisir des couleurs hors de portée d'une peinture — c'est
    // ce qui produisait des correspondances décevantes sur les teintes vives.
    const freeHex = document.getElementById("mf-free-hex") as HTMLInputElement | null;
    const matches = document.getElementById("mf-free-matches");
    const wheel = document.getElementById("mf-wheel") as HTMLCanvasElement | null;
    const valueSlider = document.getElementById("mf-wheel-value") as HTMLInputElement | null;
    const BANDE = 16;
    let choisi: string | null = null;

    function positions(size: number) {
      const L = Number(valueSlider?.value || 50);
      const r = size / 2;
      const marge = 24;
      const visibles = (RAL_WHEEL as any[]).filter((c) => Math.abs(c.L - L) <= BANDE);
      // Le rayon est réparti sur la saturation réellement présente à cette
      // clarté, pas sur le maximum de tout le nuancier : sinon une tranche de
      // teintes sombres et peu saturées s'entasse au centre et devient
      // impossible à viser.
      const maxR = Math.max(0.08, ...visibles.map((c) => c.rayon));
      return visibles.map((c) => {
        const rad = (c.angle * Math.PI) / 180;
        const d = (0.18 + 0.82 * (c.rayon / maxR)) * (r - marge);
        return { ...c, x: r + Math.cos(rad) * d, y: r + Math.sin(rad) * d };
      });
    }

    function drawWheel() {
      if (!wheel) return;
      const ctx = wheel.getContext("2d");
      if (!ctx) return;
      const size = wheel.width;
      ctx.clearRect(0, 0, size, size);
      ctx.beginPath();
      ctx.arc(size / 2, size / 2, size / 2 - 1, 0, Math.PI * 2);
      ctx.fillStyle = "rgba(255,255,255,.05)";
      ctx.fill();

      const pts = positions(size);
      for (const c of pts) {
        ctx.beginPath();
        ctx.arc(c.x, c.y, 15, 0, Math.PI * 2);
        ctx.fillStyle = c.hex;
        ctx.fill();
        const actif = c.ral === choisi;
        ctx.strokeStyle = actif ? "#fff" : "rgba(0,0,0,.5)";
        ctx.lineWidth = actif ? 5 : 1.5;
        ctx.stroke();
      }
      if (pts.length === 0) {
        ctx.fillStyle = "rgba(255,255,255,.5)";
        ctx.font = "15px sans-serif";
        ctx.textAlign = "center";
        ctx.fillText("Aucune teinte à cette clarté", size / 2, size / 2);
      }
    }

    function pickFromWheel(clientX: number, clientY: number) {
      if (!wheel) return;
      const rect = wheel.getBoundingClientRect();
      const echelle = wheel.width / rect.width;
      const x = (clientX - rect.left) * echelle;
      const y = (clientY - rect.top) * echelle;
      let best: any = null;
      let bestD = Infinity;
      for (const c of positions(wheel.width)) {
        const d = Math.hypot(c.x - x, c.y - y);
        if (d < bestD) { bestD = d; best = c; }
      }
      if (!best || bestD > 34) return;
      choisi = best.ral;
      drawWheel();
      if (freeHex) freeHex.value = best.hex;
      select(best.ral, best.nom, best.hex);
      renderMatches(best.hex, false);
    }

    let dragging = false;
    wheel?.addEventListener("pointerdown", (e) => {
      dragging = true;
      wheel.setPointerCapture(e.pointerId);
      pickFromWheel(e.clientX, e.clientY);
    });
    wheel?.addEventListener("pointermove", (e) => {
      if (dragging) pickFromWheel(e.clientX, e.clientY);
    });
    wheel?.addEventListener("pointerup", () => { dragging = false; });
    wheel?.addEventListener("pointercancel", () => { dragging = false; });
    valueSlider?.addEventListener("input", drawWheel);

    function renderMatches(hex: string, autoSelect = true) {
      if (!matches) return;
      const found = nearestRal(hex, 3);
      if (!found) return;
      matches.innerHTML = "";
      (found as any[]).forEach((c, i) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className =
          "mf-swatch flex items-center gap-2 rounded-md border p-2 text-left hover:border-(--color-forge-500) " +
          (i === 0 ? "border-(--color-forge-500)" : "border-(--color-line)");
        btn.dataset.ral = c.ral;
        btn.dataset.nom = c.nom;
        btn.dataset.hex = c.hex;
        // L'écart perceptuel : en dessous de 2 l'œil ne fait pas la différence.
        const proximite = c.ecart < 2 ? "identique à l'œil" : c.ecart < 5 ? "très proche" : "proche";
        btn.innerHTML =
          `<span class="h-8 w-8 shrink-0 rounded" style="background:${c.hex}"></span>` +
          `<span class="min-w-0"><span class="block truncate text-xs text-(--color-paper)">RAL ${c.ral}</span>` +
          `<span class="block truncate text-[0.65rem] text-(--color-fog)">${c.nom} · ${proximite}</span></span>`;
        matches.appendChild(btn);
      });
      // À l'ouverture on montre seulement ce que donnerait la roue, sans
      // écraser la couleur déjà sélectionnée dans un autre onglet.
      if (!autoSelect) return;
      const best = (found as any[])[0];
      select(best.ral, best.nom, best.hex);
    }

    // Saisie d'un code : on retient le RAL le plus proche et on amène la roue
    // sur sa tranche de clarté pour que le repère soit visible.
    freeHex?.addEventListener("input", () => {
      const v = freeHex.value.trim();
      if (!/^#?[0-9a-fA-F]{6}$/.test(v)) return;
      const hex = (v.startsWith("#") ? v : `#${v}`).toUpperCase();
      const best = nearestRal(hex) as any;
      if (!best) return;
      choisi = best.ral;
      const w = (RAL_WHEEL as any[]).find((c) => c.ral === best.ral);
      if (w && valueSlider) valueSlider.value = String(Math.round(w.L));
      drawWheel();
      renderMatches(hex);
    });

    drawWheel();
    select("9005", "Noir foncé", "#0A0A0A");
  }
</script>
