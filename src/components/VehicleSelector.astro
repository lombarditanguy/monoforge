---
// Sélecteur de véhicule de la page d'accueil.
//
// Il ne sert pas à filtrer le catalogue — toutes nos jantes sont forgées à la
// cote, donc aucune n'est « incompatible ». Il sert à répondre tout de suite à
// la question que se pose le visiteur : « qu'est-ce qu'il faut, sur ma
// voiture ? ». L'entraxe, l'alésage et les tailles d'origine sortent des cotes
// constructeur déjà en base, et personne d'autre sur ce marché ne les affiche
// avant d'avoir fait remplir un formulaire.
---

<section class="container-mf py-16" id="mf-vehicule">
  <div class="card-mf p-8 md:p-10">
    <p class="section-label">Votre véhicule</p>
    <h2 class="mt-4 max-w-2xl text-balance font-display text-2xl font-bold text-(--color-paper) md:text-3xl">
      Quelles cotes faut-il, sur votre voiture&nbsp;?
    </h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-(--color-mist)">
      Entraxe, alésage et tailles d'origine, d'après les cotes constructeur. Aucune inscription.
    </p>

    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
      <div>
        <label for="mf-marque" class="mb-1.5 block text-xs uppercase tracking-widest text-(--color-fog)">Marque</label>
        <select id="mf-marque" class="w-full rounded border border-(--color-line) bg-(--color-surface-2) px-4 py-3 text-sm text-(--color-paper) focus:border-(--color-forge-500) focus:outline-none">
          <option value="">Chargement…</option>
        </select>
      </div>
      <div>
        <label for="mf-modele" class="mb-1.5 block text-xs uppercase tracking-widest text-(--color-fog)">Modèle</label>
        <select id="mf-modele" disabled class="w-full rounded border border-(--color-line) bg-(--color-surface-2) px-4 py-3 text-sm text-(--color-paper) focus:border-(--color-forge-500) focus:outline-none disabled:opacity-50">
          <option value="">Choisissez d'abord une marque</option>
        </select>
      </div>
      <a href="/catalogue" class="btn btn-outline whitespace-nowrap sm:mb-0.5">Voir le catalogue</a>
    </div>

    <p id="mf-vehicule-erreur" class="mt-4 hidden text-sm text-(--color-mist)"></p>

    <div id="mf-vehicule-cotes" class="mt-8 hidden border-t border-(--color-line) pt-8">
      <dl class="grid grid-cols-2 gap-6 sm:grid-cols-4">
        <div>
          <dt class="text-xs uppercase tracking-widest text-(--color-fog)">Entraxe</dt>
          <dd id="mf-cote-entraxe" class="mt-1.5 font-display text-xl font-bold text-(--color-paper)">—</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-widest text-(--color-fog)">Alésage</dt>
          <dd id="mf-cote-alesage" class="mt-1.5 font-display text-xl font-bold text-(--color-paper)">—</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-widest text-(--color-fog)">Tailles d'origine</dt>
          <dd id="mf-cote-diametres" class="mt-1.5 font-display text-xl font-bold text-(--color-paper)">—</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-widest text-(--color-fog)">Cotes référencées</dt>
          <dd id="mf-cote-montes" class="mt-1.5 font-display text-xl font-bold text-(--color-paper)">—</dd>
        </div>
      </dl>
      <p class="mt-6 text-sm leading-relaxed text-(--color-mist)">
        Nous forgeons hors de ces tailles sans supplément : le déport est recalculé pour votre véhicule au moment de la commande. <a href="/sur-mesure" class="underline hover:text-(--color-paper)">Comment ça marche</a>
      </p>
    </div>
  </div>
</section>

<script>
  const marqueEl = document.getElementById("mf-marque") as HTMLSelectElement | null;
  const modeleEl = document.getElementById("mf-modele") as HTMLSelectElement | null;
  const cotesEl = document.getElementById("mf-vehicule-cotes");
  const erreurEl = document.getElementById("mf-vehicule-erreur");
  if (marqueEl && modeleEl && cotesEl && erreurEl) {
    const remplir = (select: HTMLSelectElement, valeurs: string[], vide: string) => {
      select.innerHTML =
        `<option value="">${vide}</option>` +
        valeurs.map((v) => `<option value="${v.replace(/"/g, "&quot;")}">${v}</option>`).join("");
    };

    const erreur = (message: string) => {
      erreurEl.textContent = message;
      erreurEl.classList.toggle("hidden", !message);
    };

    const charger = async (url: string) => {
      const res = await fetch(url);
      const json = await res.json().catch(() => null);
      if (!res.ok || !json) throw new Error(json?.message || "Indisponible");
      return json;
    };

    // La liste des marques part tout de suite. Elle avait d'abord été chargée
    // à l'entrée du bloc dans le viewport, pour économiser la requête tant
    // qu'on ne descend pas — mais quelques kilo-octets de JSON ne valent pas
    // une liste déroulante qui peut être vide au moment précis où on clique
    // dessus. Elle est prête avant que le visiteur ait fini de lire le hero.
    charger("/api/vehicules")
      .then((d) => remplir(marqueEl, d.marques || [], "Choisissez une marque"))
      .catch(() => {
        remplir(marqueEl, [], "Indisponible");
        erreur("La base des cotes constructeur est momentanément injoignable.");
      });

    marqueEl.addEventListener("change", async () => {
      cotesEl.classList.add("hidden");
      erreur("");
      modeleEl.disabled = true;
      if (!marqueEl.value) {
        remplir(modeleEl, [], "Choisissez d'abord une marque");
        return;
      }
      remplir(modeleEl, [], "Chargement…");
      try {
        const d = await charger(`/api/vehicules?marque=${encodeURIComponent(marqueEl.value)}`);
        remplir(modeleEl, d.modeles || [], "Choisissez un modèle");
        modeleEl.disabled = false;
      } catch {
        remplir(modeleEl, [], "Indisponible");
        erreur("Impossible de charger les modèles de cette marque.");
      }
    });

    modeleEl.addEventListener("change", async () => {
      cotesEl.classList.add("hidden");
      erreur("");
      if (!modeleEl.value) return;
      try {
        const d = await charger(
          `/api/vehicules?marque=${encodeURIComponent(marqueEl.value)}&modele=${encodeURIComponent(modeleEl.value)}`
        );
        const texte = (id: string, valeur: string) => {
          const el = document.getElementById(id);
          if (el) el.textContent = valeur;
        };
        // Un entraxe manquant veut dire que le jeu de données se contredit sur
        // ce modèle : on préfère un tiret à une valeur choisie au hasard.
        texte("mf-cote-entraxe", d.entraxe || (d.entraxes?.length ? d.entraxes.join(" / ") : "—"));
        texte("mf-cote-alesage", d.alesage || "—");
        texte(
          "mf-cote-diametres",
          d.diametres?.length
            ? (d.diametres.length > 1
                ? `${d.diametres[0]}″ à ${d.diametres[d.diametres.length - 1]}″`
                : `${d.diametres[0]}″`)
            : "—"
        );
        texte("mf-cote-montes", String(d.montes ?? "—"));
        cotesEl.classList.remove("hidden");
      } catch (e) {
        erreur(e instanceof Error ? e.message : "Cotes indisponibles pour ce modèle.");
      }
    });
  }
</script>
