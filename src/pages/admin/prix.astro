---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import { sql } from "../../lib/db.js";

let priceBases = [];
let sizeCoefficients = [];
let finishes = [];
let coefficients = [];
let dbError = null;
try {
  priceBases = await sql`select * from price_bases order by famille asc`;
  sizeCoefficients = await sql`select * from size_coefficients order by ordre asc, id asc`;
  finishes = await sql`select * from finish_options order by position asc, id asc`;
  coefficients = await sql`select * from coefficients order by label asc`;
} catch (err) {
  dbError = err.message;
}

function ventebase(p) {
  return Number(p.prix_achat_ht || 0) * Number(p.coefficient_revente || 0);
}
---

<AdminLayout title="Prix & coefficients">
  <h1>Prix & coefficients</h1>
  <p class="muted" style="margin-top:-.5rem">
    Ton prix d'achat n'est jamais visible par le client — seul le prix de vente calculé (achat × coefficient) s'affiche sur le site.
  </p>
  {dbError && <div class="notice">{dbError}</div>}

  {!dbError && (
    <>
      <div class="card">
        <h2 style="margin-top:0">Familles — prix d'achat & coefficient de revente</h2>
        <p class="muted">
          Prix de base HT pour la taille la plus petite (voir coefficients de taille ci-dessous), sans finition.
          Prix de vente = prix d'achat × coefficient.
        </p>
        {priceBases.length === 0 && <p class="muted">Aucune famille pour l'instant — ajoute-en une ci-dessous.</p>}
        {priceBases.map((p) => (
          <div class="edit-row">
            <p class="edit-row-title">{p.label} <span class="muted">({p.famille})</span></p>
            <form method="POST" action="/api/admin/prix">
              <input type="hidden" name="type" value="price_base" />
              <input type="hidden" name="id" value={p.id} />
              <input type="hidden" name="famille" value={p.famille} />
              <input type="hidden" name="label" value={p.label} />
              <div class="field-row">
                <div>
                  <label for={`achat-${p.id}`}>Prix d'achat HT (€)</label>
                  <input id={`achat-${p.id}`} name="prix_achat_ht" type="number" step="0.01" value={p.prix_achat_ht} />
                </div>
                <div>
                  <label for={`coeff-${p.id}`}>Coefficient de revente</label>
                  <input id={`coeff-${p.id}`} name="coefficient_revente" type="number" step="0.01" value={p.coefficient_revente} />
                </div>
                <div>
                  <label>→ Prix de vente calculé</label>
                  <p class="computed">{ventebase(p).toFixed(2)} € HT</p>
                </div>
              </div>
              <button class="btn btn-outline" type="submit">Enregistrer</button>
              <button class="btn btn-outline btn-danger" type="submit" formaction="/api/admin/prix" data-delete data-type="price_base" data-id={p.id}>Supprimer</button>
            </form>
          </div>
        ))}
        <details style="margin-top:1rem">
          <summary class="muted" style="cursor:pointer">+ Ajouter une famille</summary>
          <form method="POST" action="/api/admin/prix" style="margin-top:1rem">
            <input type="hidden" name="type" value="price_base" />
            <div class="field-row">
              <div>
                <label for="famille">Famille (slug)</label>
                <input id="famille" name="famille" placeholder="monobloc" required />
              </div>
              <div>
                <label for="label">Libellé</label>
                <input id="label" name="label" placeholder="Monobloc — 1 pièce" required />
              </div>
              <div>
                <label for="prix_achat_ht">Prix d'achat HT (€)</label>
                <input id="prix_achat_ht" name="prix_achat_ht" type="number" step="0.01" required />
              </div>
              <div>
                <label for="coefficient_revente">Coefficient de revente</label>
                <input id="coefficient_revente" name="coefficient_revente" type="number" step="0.01" value="1.5" required />
              </div>
            </div>
            <button class="btn" type="submit">Ajouter</button>
          </form>
        </details>
      </div>

      <div class="card">
        <h2 style="margin-top:0">Coefficients par taille</h2>
        <p class="muted">
          Multiplicateur appliqué au prix de vente de base selon le diamètre choisi par le client (1.00 = taille de
          base, pas de variation ; 1.10 = +10% par rapport à la base, etc.).
        </p>
        {sizeCoefficients.map((s) => (
          <div class="edit-row">
            <form method="POST" action="/api/admin/prix">
              <input type="hidden" name="type" value="size_coefficient" />
              <input type="hidden" name="id" value={s.id} />
              <div class="field-row">
                <div>
                  <label for={`taille-${s.id}`}>Taille</label>
                  <input id={`taille-${s.id}`} name="taille" value={s.taille} />
                </div>
                <div>
                  <label for={`ordre-${s.id}`}>Ordre d'affichage</label>
                  <input id={`ordre-${s.id}`} name="ordre" type="number" value={s.ordre} />
                </div>
                <div>
                  <label for={`coeff-taille-${s.id}`}>Coefficient</label>
                  <input id={`coeff-taille-${s.id}`} name="coefficient" type="number" step="0.001" value={s.coefficient} />
                </div>
              </div>
              <button class="btn btn-outline" type="submit">Enregistrer</button>
              <button class="btn btn-outline btn-danger" type="submit" data-delete data-type="size_coefficient" data-id={s.id}>Supprimer</button>
            </form>
          </div>
        ))}
        <details style="margin-top:1rem">
          <summary class="muted" style="cursor:pointer">+ Ajouter une taille</summary>
          <form method="POST" action="/api/admin/prix" style="margin-top:1rem">
            <input type="hidden" name="type" value="size_coefficient" />
            <div class="field-row">
              <div>
                <label for="taille">Taille</label>
                <input id="taille" name="taille" placeholder='25"' required />
              </div>
              <div>
                <label for="ordre">Ordre d'affichage</label>
                <input id="ordre" name="ordre" type="number" value="99" required />
              </div>
              <div>
                <label for="coefficient">Coefficient</label>
                <input id="coefficient" name="coefficient" type="number" step="0.001" value="1" required />
              </div>
            </div>
            <button class="btn" type="submit">Ajouter</button>
          </form>
        </details>
      </div>

      <div class="card">
        <h2 style="margin-top:0">Finitions</h2>
        <p class="muted">
          Proposées au client sur la fiche produit (voir tableau fournisseur). Prix d'achat HT + coefficient de
          revente → supplément ajouté au prix de vente. Décoche "Active" pour la masquer sans la supprimer.
        </p>
        {finishes.map((f) => (
          <div class="edit-row">
            <form method="POST" action="/api/admin/prix" data-finish-form>
              <input type="hidden" name="type" value="finish_option" />
              <input type="hidden" name="id" value={f.id} />
              <input type="hidden" name="position" value={f.position} />
              <div class="field-row">
                <div>
                  <label for={`flabel-${f.id}`}>Libellé</label>
                  <input id={`flabel-${f.id}`} name="label" value={f.label} />
                </div>
                <div>
                  <label for={`fachat-${f.id}`}>Prix d'achat HT (€)</label>
                  <input id={`fachat-${f.id}`} name="prix_achat_ht" type="number" step="0.01" value={f.prix_achat_ht} />
                </div>
                <div>
                  <label for={`fcoeff-${f.id}`}>Coefficient de revente</label>
                  <input id={`fcoeff-${f.id}`} name="coefficient_revente" type="number" step="0.01" value={f.coefficient_revente} />
                </div>
                <div>
                  <label>→ Supplément vente</label>
                  <p class="computed">+{(Number(f.prix_achat_ht || 0) * Number(f.coefficient_revente || 0)).toFixed(2)} €</p>
                </div>
              </div>
              <label style="display:flex;align-items:center;gap:.4rem;margin-bottom:1rem">
                <input type="checkbox" name="actif" value="1" checked={f.actif} style="width:auto;margin:0" /> Finition active (visible côté client)
              </label>
              <button class="btn btn-outline" type="submit">Enregistrer</button>
              <button class="btn btn-outline btn-danger" type="submit" data-delete data-type="finish_option" data-id={f.id}>Supprimer</button>
            </form>
          </div>
        ))}
        <details style="margin-top:1rem">
          <summary class="muted" style="cursor:pointer">+ Ajouter une finition</summary>
          <form method="POST" action="/api/admin/prix" style="margin-top:1rem">
            <input type="hidden" name="type" value="finish_option" />
            <div class="field-row">
              <div>
                <label for="f_label">Libellé</label>
                <input id="f_label" name="label" placeholder="Chromé" required />
              </div>
              <div>
                <label for="f_achat">Prix d'achat HT (€)</label>
                <input id="f_achat" name="prix_achat_ht" type="number" step="0.01" value="0" required />
              </div>
              <div>
                <label for="f_coeff">Coefficient de revente</label>
                <input id="f_coeff" name="coefficient_revente" type="number" step="0.01" value="1.5" required />
              </div>
            </div>
            <button class="btn" type="submit">Ajouter</button>
          </form>
        </details>
      </div>

      <div class="card">
        <h2 style="margin-top:0">Coefficients généraux</h2>
        <p class="muted">
          Multiplicateurs libres, non liés à une taille ou une finition précise (ex : dessin inédit, délai
          express...) — utilisables au moment de préparer un devis ou une facture manuellement.
        </p>
        {coefficients.map((c) => (
          <div class="edit-row">
            <p class="edit-row-title">{c.label} <span class="muted">— actuellement ×{Number(c.valeur).toFixed(2)}{c.description ? ` (${c.description})` : ""}</span></p>
            <form method="POST" action="/api/admin/prix">
              <input type="hidden" name="type" value="coefficient" />
              <input type="hidden" name="id" value={c.id} />
              <input type="hidden" name="label" value={c.label} />
              <input type="hidden" name="description" value={c.description || ""} />
              <div class="field-row">
                <div>
                  <label for={`cvaleur-${c.id}`}>Coefficient</label>
                  <input id={`cvaleur-${c.id}`} name="valeur" type="number" step="0.01" value={c.valeur} />
                </div>
              </div>
              <button class="btn btn-outline" type="submit">Enregistrer</button>
              <button class="btn btn-outline btn-danger" type="submit" data-delete data-type="coefficient" data-id={c.id}>Supprimer</button>
            </form>
          </div>
        ))}
        <details style="margin-top:1rem">
          <summary class="muted" style="cursor:pointer">+ Ajouter un coefficient</summary>
          <form method="POST" action="/api/admin/prix" style="margin-top:1rem">
            <input type="hidden" name="type" value="coefficient" />
            <div class="field-row">
              <div>
                <label for="c_label">Libellé</label>
                <input id="c_label" name="label" placeholder="Dessin inédit" required />
              </div>
              <div>
                <label for="c_valeur">Coefficient</label>
                <input id="c_valeur" name="valeur" type="number" step="0.01" value="1" required />
              </div>
            </div>
            <label for="c_desc">Description</label>
            <input id="c_desc" name="description" placeholder="Dessin de bâtons entièrement nouveau" />
            <button class="btn" type="submit">Ajouter</button>
          </form>
        </details>
      </div>
    </>
  )}

  <style>
    .edit-row {
      border: 1px solid #1c1c20;
      border-radius: 0.4rem;
      padding: 1rem;
      margin-bottom: 1rem;
    }
    .edit-row-title {
      margin: 0 0 0.75rem;
      font-weight: 600;
    }
    .edit-row form {
      margin: 0;
    }
    .computed {
      margin: 0;
      padding: 0.55rem 0;
      font-weight: 700;
    }
    .btn-danger {
      color: #e5484d;
      margin-left: 0.5rem;
    }
  </style>

  <script>
    document.querySelectorAll("button[data-delete]").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        e.preventDefault();
        if (!confirm("Supprimer cette ligne ?")) return;
        const type = btn.getAttribute("data-type");
        const id = btn.getAttribute("data-id");
        await fetch("/api/admin/prix", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ type, id }),
        });
        window.location.reload();
      });
    });
    document.querySelectorAll("form[data-finish-form]").forEach((form) => {
      form.addEventListener("submit", () => {
        const checkbox = form.querySelector('input[name="actif"]');
        if (checkbox && !checkbox.checked) {
          const hidden = document.createElement("input");
          hidden.type = "hidden";
          hidden.name = "actif";
          hidden.value = "0";
          form.appendChild(hidden);
        }
      });
    });
  </script>
</AdminLayout>
