---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import { sql } from "../../lib/db.js";
import { countOeFitments } from "../../lib/fitment.js";

let counts = { clients: 0, factures: 0, brouillons: 0 };
let dbError = null;
try {
  const [clientsRow] = await sql`select count(*)::int as n from clients`;
  const [facturesRow] = await sql`select count(*)::int as n from invoices`;
  const [brouillonsRow] = await sql`select count(*)::int as n from invoices where statut = 'brouillon'`;
  counts = { clients: clientsRow.n, factures: facturesRow.n, brouillons: brouillonsRow.n };
} catch (err) {
  dbError = err.message;
}

let itemPricesMissing = false;
if (!dbError) {
  try {
    await sql`select 1 from item_prices limit 1`;
  } catch {
    itemPricesMissing = true;
  }
}

let cotes = { lignes: 0, marques: 0 };
if (!dbError) {
  try {
    cotes = await countOeFitments();
  } catch {
    cotes = { lignes: 0, marques: 0 };
  }
}

// État des services externes. On n'expose jamais les valeurs, uniquement la
// présence de la variable : c'est ce qui distingue « pas configuré » d'un
// vrai bug, et évite de fouiller le dashboard Vercel à chaque incident.
const integrations = [
  {
    nom: "Base de données",
    ok: !dbError,
    variable: "DATABASE_URL",
    role: "Commandes, clients, prix, factures.",
    aide: "Vercel → Storage → connecter la base Postgres au projet, puis /admin/setup.",
  },
  {
    nom: "Stockage des photos",
    ok: Object.keys(process.env).some((k) => k.startsWith("BLOB_")),
    variable: "BLOB_STORE_ID / BLOB_READ_WRITE_TOKEN",
    role: "Ajout de photos sur les jantes. Réordonner et supprimer marchent sans.",
    aide: "Vercel → Storage → créer un store Blob en accès PUBLIC (le mode ne se change plus ensuite) → onglet Projects → connecter ce projet, puis redéployer.",
  },
  {
    nom: "Paiement Stripe",
    ok: Boolean(process.env.STRIPE_SECRET_KEY),
    variable: "STRIPE_SECRET_KEY",
    role: "Encaissement des commandes. Sans clé, la commande est enregistrée mais non payée.",
    aide: "Dashboard Stripe → clé secrète → Vercel → Settings → Environment Variables.",
  },
  {
    nom: "Recherche par plaque",
    ok: Boolean(process.env.AUTOWAYS_API_KEY),
    variable: "AUTOWAYS_API_KEY",
    role: "Identifie le véhicule du client (marque, modèle, année, finition).",
    aide: "Compte auto-ways.net → Clés API.",
  },
  {
    nom: "Cotes constructeur",
    ok: cotes.lignes > 0,
    manque: "Aucune donnée chargée",
    role:
      cotes.lignes > 0
        ? `${cotes.lignes.toLocaleString("fr-FR")} montes d'origine sur ${cotes.marques} marques — le déport des commandes est calculé automatiquement.`
        : "Déport de la monte d'origine sur les commandes catalogue.",
    aide: "Charge le jeu de données acheté depuis /admin/fitments. Sans lui, le déport se renseigne à la main.",
  },
  {
    nom: "API cotes jante (déport)",
    ok: Boolean(process.env.VDIM_API_KEY || process.env.WHEELSIZE_API_KEY),
    variable: "VDIM_API_KEY",
    role: "Abandonné : catalogue nord-américain, non fiable sur les véhicules européens. Remplacé par les cotes constructeur ci-dessus.",
    aide: "Non configuré = fonctionnement normal aujourd'hui.",
    facultatif: true,
  },
];
---

<AdminLayout title="Tableau de bord">
  <h1>Tableau de bord</h1>

  <div class="card">
    <h2 style="margin-top:0">État des services</h2>
    <p class="muted">
      Ce que le site voit réellement depuis l'environnement en cours d'exécution. Aucune clé n'est affichée,
      seulement leur présence — c'est ce qui permet de distinguer un service non configuré d'un vrai
      dysfonctionnement.
    </p>
    <table>
      <tbody>
        {integrations.map((s) => (
          <tr>
            <td style="width:1.5rem">
              <span
                title={s.ok ? "Configuré" : s.facultatif ? "Non configuré (facultatif)" : "Non configuré"}
                style={`display:inline-block;width:.65rem;height:.65rem;border-radius:50%;background:${
                  s.ok ? "#3fb950" : s.facultatif ? "#8b949e" : "#ff7a45"
                }`}
              ></span>
            </td>
            <th style="white-space:nowrap">{s.nom}</th>
            <td>
              <div>{s.role}</div>
              {!s.ok && (
                <div class="muted" style="font-size:.85em;margin-top:.25rem">
                  {s.manque ? s.manque : <><code>{s.variable}</code> absente</>} — {s.aide}
                </div>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {dbError && (
    <div class="notice">
      <strong>Base de données non connectée.</strong> {dbError}
      <br />
      Va sur <a href="/admin/setup" style="color:#ff7a45">/admin/setup</a> une fois la base activée côté Vercel pour initialiser les tables.
    </div>
  )}

  {itemPricesMissing && (
    <div class="notice">
      <strong>Prix par jante pas encore initialisés.</strong> Les fiches produit affichent "sur devis" tant que ce n'est pas fait.
      <br />
      Va sur <a href="/admin/setup" style="color:#ff7a45">/admin/setup</a> et clique sur "Initialiser / vérifier les tables" — ça remplit automatiquement les 457 prix d'achat depuis le catalogue, sans risque pour les données existantes.
    </div>
  )}

  {!dbError && (
    <div class="field-row">
      <div class="card">
        <p class="muted" style="margin:0 0 .3rem;font-size:.8rem">Clients</p>
        <p style="margin:0;font-size:2rem;font-weight:700">{counts.clients}</p>
      </div>
      <div class="card">
        <p class="muted" style="margin:0 0 .3rem;font-size:.8rem">Factures</p>
        <p style="margin:0;font-size:2rem;font-weight:700">{counts.factures}</p>
      </div>
      <div class="card">
        <p class="muted" style="margin:0 0 .3rem;font-size:.8rem">Brouillons</p>
        <p style="margin:0;font-size:2rem;font-weight:700">{counts.brouillons}</p>
      </div>
    </div>
  )}

  <div class="card">
    <p class="muted" style="margin-top:0">Accès rapides</p>
    <div style="display:flex;gap:.75rem;flex-wrap:wrap">
      <a class="btn" href="/admin/factures/nouveau">Nouvelle facture</a>
      <a class="btn btn-outline" href="/admin/clients/nouveau">Nouveau client</a>
      <a class="btn btn-outline" href="/admin/vitrine">Vitrine page d'accueil</a>
      <a class="btn btn-outline" href="/admin/prix">Gérer les prix</a>
      <a class="btn btn-outline" href="/admin/prix-jantes">Prix par jante</a>
      <a class="btn btn-outline" href="/admin/setup">Initialiser / vérifier les tables</a>
    </div>
  </div>
</AdminLayout>
