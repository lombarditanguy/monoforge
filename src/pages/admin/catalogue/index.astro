---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { FAMILIES } from "../../../data/catalog.js";
import { listAllItemsForAdmin, isStaticItem, ordreAccueil } from "../../../lib/catalogDb.js";

let items = [];
let rangs = new Map();
let dbError = null;
try {
  items = await listAllItemsForAdmin();
  // Même source que le site : les cases montrent l'ordre réellement appliqué,
  // y compris l'ordre initial tant que rien n'a été enregistré.
  rangs = await ordreAccueil();
} catch (err) {
  dbError = err.message;
}

// Les jantes qui ont un rang remontent en tête de leur famille, ici comme sur
// le site : la liste d'admin doit montrer l'ordre réel, sinon on règle à
// l'aveugle.
const itemsByFamily = FAMILIES.map((family) => ({
  family,
  items: items
    .filter((i) => i.family === family.slug)
    .map((item, ordre) => ({ item, ordre, rang: rangs.get(item.code) }))
    .sort((a, b) => {
      if (a.rang !== undefined && b.rang !== undefined) return a.rang - b.rang;
      if (a.rang !== undefined) return -1;
      if (b.rang !== undefined) return 1;
      return a.ordre - b.ordre;
    })
    .map((x) => ({ ...x.item, rang: x.rang })),
}));
---

<AdminLayout title="Catalogue">
  <h1>Catalogue</h1>
  <p class="muted" style="margin-top:-.5rem">
    {items.length} références au total. Le catalogue fournisseur (jantes déjà présentes) n'est pas listé pour
    suppression ici — seules ses photos sont modifiables. Les jantes que tu ajoutes toi-même peuvent être gérées
    librement. La colonne « Nom fournisseur » est le nom exact de l'annonce chez XINLAI — c'est ce qu'il faut
    chercher ou renvoyer pour recommander la même jante (on n'a pas de code SKU court côté fournisseur, juste ce nom).
  </p>
  {dbError && <div class="notice">{dbError}</div>}

  {!dbError && (
    <>
      <div class="card" style="display:flex;gap:.75rem;flex-wrap:wrap">
        <a class="btn" href="/admin/catalogue/nouveau">+ Ajouter une jante</a>
        <input id="mf-search" placeholder="Filtrer par référence ou nom fournisseur (ex: DZ-014, chrome)" style="margin:0;max-width:24rem" />
        <button type="button" class="btn" id="mf-save-rangs">Enregistrer l'ordre</button>
        <span class="muted" id="mf-rangs-etat" style="align-self:center"></span>
      </div>

      {itemsByFamily.map(({ family, items: familyItems }) => (
        <div class="card">
          <h2 style="margin-top:0">{family.label} <span class="muted">({familyItems.length} références)</span></h2>
          <table>
            <thead>
              <tr>
                <th style="width:4.5rem">Photo</th>
                <th>Référence</th>
                <th>Nom fournisseur</th>
                <th>Origine</th>
                <th style="width:7rem">Rang accueil</th>
                <th style="width:16rem"></th>
              </tr>
            </thead>
            <tbody>
              {familyItems.map((item) => (
                <tr
                  data-row
                  data-code={item.code.toLowerCase()}
                  data-name={(item.supplierName || "").toLowerCase()}
                  data-ref={item.code}
                  data-statique={isStaticItem(item.code) ? "1" : "0"}
                  data-retire={item.retire ? "1" : "0"}
                  style={item.retire ? "opacity:.45" : ""}
                >
                  <td><img src={item.image} alt="" width="40" height="40" style="border-radius:.25rem;object-fit:cover;display:block" /></td>
                  <td>
                    {item.code}
                    {item.retire && <div class="muted" style="font-size:.72rem;color:#ff7a45">Retirée du site</div>}
                  </td>
                  <td class="muted" style="max-width:22rem">{item.supplierName || "—"}</td>
                  <td class="muted">{isStaticItem(item.code) ? "Catalogue fournisseur" : "Ajoutée par l'admin"}</td>
                  <td>
                    <input
                      class="mf-rang"
                      type="number"
                      min="1"
                      step="1"
                      inputmode="numeric"
                      placeholder="—"
                      data-code={item.code}
                      value={item.rang ?? ""}
                      style="margin:0;padding:.35rem .5rem;text-align:center"
                    />
                  </td>
                  <td>
                    <div style="display:flex;gap:.4rem;flex-wrap:wrap">
                      <a class="btn btn-outline" href={`/admin/catalogue/${item.code}`}>Photos</a>
                      <button type="button" class="btn btn-outline mf-retirer" style="white-space:nowrap">
                        {item.retire ? "Remettre en ligne" : "Retirer du site"}
                      </button>
                      {item.retire && !isStaticItem(item.code) && (
                        <button type="button" class="btn btn-outline mf-supprimer" style="white-space:nowrap;color:#ff7a45">
                          Supprimer
                        </button>
                      )}
                    </div>
                    {/* Le compte rendu se lit à côté du bouton. Placé en tête de
                        page, il était invisible depuis une ligne située plus
                        bas : on cliquait, l'erreur s'affichait à des milliers de
                        pixels de là, et le bouton passait pour inerte. */}
                    <span class="mf-ligne-etat muted" style="display:block;font-size:.75rem;margin-top:.35rem"></span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </>
  )}

  <script>
    const etat = document.getElementById("mf-rangs-etat");
    const search = document.getElementById("mf-search") as HTMLInputElement | null;
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>("tr[data-row]"));
    search?.addEventListener("input", () => {
      const q = (search.value || "").trim().toLowerCase();
      for (const row of rows) {
        const match = !q || (row.dataset.code || "").includes(q) || (row.dataset.name || "").includes(q);
        row.style.display = match ? "" : "none";
      }
    });

    // Retirer une jante du site. Pour le catalogue fournisseur c'est un
    // masquage : la référence est écrite dans le code, on ne peut pas l'en
    // effacer, mais la masquer la fait disparaître partout — grille, fiche,
    // recherche — et se défait sans rien perdre. Les jantes ajoutées ici, elles,
    // n'existent qu'en base : une fois retirées, elles peuvent être supprimées
    // pour de bon.
    async function agir(ligne, action, question) {
      if (question && !confirm(question)) return;
      const ref = ligne.dataset.ref;
      const dire = (msg) => {
        const local = ligne.querySelector(".mf-ligne-etat");
        if (local) local.textContent = msg;
        if (etat) etat.textContent = msg;
      };
      dire("…");
      try {
        const res = await fetch("/api/admin/catalogue/retirer", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ code: ref, action }),
        });
        // Une panne côté serveur renvoie une page HTML, pas du JSON : sans ce
        // garde-fou, la lecture échouait et le vrai message était remplacé par
        // une erreur d'analyse incompréhensible.
        const json = await res.json().catch(() => ({}));
        if (!res.ok) {
          throw new Error(json.error || `Le serveur a répondu ${res.status}. Réessaie dans un instant.`);
        }
        if (action === "supprimer") {
          ligne.remove();
          if (etat) {
            etat.textContent = json.commandes
              ? `${ref} supprimée. ${json.commandes} commande(s) la mentionnent — leur historique est conservé.`
              : `${ref} supprimée définitivement.`;
          }
          return;
        }
        // Le bouton « Supprimer » n'apparaît qu'après un retrait, et la ligne
        // change d'aspect : plutôt que de reconstruire la ligne à la main, on
        // recharge — c'est une action rare, et l'état affiché reste celui de la
        // base plutôt qu'une supposition du navigateur.
        window.location.reload();
      } catch (err) {
        dire(err instanceof Error ? err.message : "Échec.");
      }
    }

    document.querySelectorAll("tr[data-row]").forEach((ligne) => {
      const l = ligne as HTMLTableRowElement;
      l.querySelector(".mf-retirer")?.addEventListener("click", () => {
        const retire = l.dataset.retire === "1";
        agir(l, retire ? "remettre" : "retirer",
          retire
            ? null
            : `Retirer ${l.dataset.ref} du site ?\n\nElle disparaîtra du catalogue, de la page d'accueil et de sa fiche produit. Photos, prix et rang sont conservés, et tu peux la remettre à tout moment.`);
      });
      l.querySelector(".mf-supprimer")?.addEventListener("click", () => {
        agir(l, "supprimer",
          `Supprimer définitivement ${l.dataset.ref} ?\n\nSes photos, son prix et son rang d'accueil seront effacés. Cette action est irréversible. Les commandes déjà passées ne sont pas touchées.`);
      });
    });

    // Ordre d'affichage en tête de famille. Un simple numéro par ligne :
    // échanger deux jantes revient à échanger deux chiffres, et une case vide
    // veut dire « laisse-la où le catalogue la met ».
    const bouton = document.getElementById("mf-save-rangs") as HTMLButtonElement | null;
    bouton?.addEventListener("click", async () => {
      const rangs = Array.from(document.querySelectorAll<HTMLInputElement>(".mf-rang"))
        .map((i) => ({ code: i.dataset.code, position: i.value.trim() }))
        .filter((r) => r.position !== "")
        .map((r) => ({ code: r.code, position: Number(r.position) }));

      bouton.disabled = true;
      if (etat) etat.textContent = "Enregistrement…";
      try {
        const res = await fetch("/api/admin/ordre-accueil", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ rangs }),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || "Échec de l'enregistrement.");
        if (etat) etat.textContent = `Ordre enregistré — ${json.count} jante${json.count > 1 ? "s" : ""} en tête. Recharge pour voir le nouvel ordre.`;
      } catch (err) {
        if (etat) etat.textContent = err instanceof Error ? err.message : "Échec.";
      } finally {
        bouton.disabled = false;
      }
    });
  </script>
</AdminLayout>
