---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import { sql } from "../../lib/db.js";
import { listAllItemsForAdmin } from "../../lib/catalogDb.js";
import { BEST_SELLERS } from "../../data/bestsellers.js";

let rows = [];
let allItems = [];
let dbError = null;
try {
  rows = await sql`select code, position, tendance, argument from home_featured order by position, code`;
  allItems = await listAllItemsForAdmin();
} catch (err) {
  dbError = err.message;
}

// Table vide = personne n'a encore réglé la vitrine : on montre la sélection
// de repli, celle que le site affiche réellement, plutôt qu'une page vierge
// qui laisserait croire que la page d'accueil n'a rien dessus.
const parDefaut = rows.length === 0;
const selection = (parDefaut ? BEST_SELLERS : rows).map((r) => {
  const item = allItems.find((i) => i.code === r.code);
  return {
    code: r.code,
    tendance: r.tendance || "",
    argument: r.argument || "",
    image: item?.image || "/catalogue/placeholder.webp",
    family: item?.family || "",
    manquant: !item,
  };
});
---

<AdminLayout title="Vitrine">
  <h1>Vitrine de la page d'accueil</h1>
  <p class="muted" style="margin-top:-.5rem">
    Les jantes affichées en page d'accueil, juste sous le sélecteur de véhicule, avec leur prix « à partir de ».
    L'ordre ici est l'ordre à l'écran. Douze au maximum — au-delà, la page d'accueil redevient un catalogue.
    <br />
    <strong>Pour changer la photo</strong> d'une jante, ouvre sa fiche : c'est la première photo de la fiche qui
    sert de vitrine. Vérifie-la en grand avant de la mettre ici — certaines photos fournisseur portent encore un
    filigrane, invisible en vignette de catalogue mais lisible sur la page d'accueil.
  </p>

  {dbError && <div class="notice">{dbError}</div>}

  {!dbError && (
    <>
      {parDefaut && (
        <div class="notice">
          Aucune sélection enregistrée : le site affiche pour l'instant la sélection issue de l'audit de marché,
          reprise ci-dessous. Enregistre pour la figer ou la modifier.
        </div>
      )}

      <div class="card vitrine-ajout">
        <label for="ajout">Ajouter une référence</label>
        <div>
          <select id="ajout">
            <option value="">Choisir une jante…</option>
            {allItems.map((i) => <option value={i.code} data-image={i.image} data-family={i.family}>{i.code} — {i.family}</option>)}
          </select>
          <button type="button" id="btn-ajouter">Ajouter à la vitrine</button>
        </div>
      </div>

      <div id="liste"></div>

      <div class="card" style="position:sticky;bottom:0;display:flex;gap:1rem;align-items:center">
        <button type="button" class="btn" id="btn-enregistrer">Enregistrer la vitrine</button>
        <span class="muted" id="etat"></span>
      </div>
    </>
  )}

  <!--
    Les styles d'AdminLayout sont scopés par Astro (`label[data-astro-cid-…]`) :
    ils ne s'appliquent qu'au HTML rendu côté serveur, pas aux cartes que le
    script ci-dessous fabrique à l'exécution. D'où ce bloc global, volontairement
    restreint à #liste pour ne rien déborder sur les autres pages d'admin.
  -->
  <style is:global>
    .vitrine-ajout label { display: block; font-size: 0.78rem; color: #a9a9b2; margin-bottom: 0.4rem; }
    .vitrine-ajout > div { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
    .vitrine-ajout select {
      flex: 1 1 22rem;
      min-width: 0;
      padding: 0.55rem 0.7rem;
      margin: 0;
      border: 1px solid #26262b;
      border-radius: 0.35rem;
      background: #1c1c20;
      color: #f3f1ec;
      font: inherit;
      font-size: 0.88rem;
    }
    .vitrine-ajout button {
      padding: 0.55rem 1.1rem;
      border-radius: 0.35rem;
      border: 1px solid #26262b;
      background: transparent;
      color: #f3f1ec;
      font: inherit;
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
    }
    .vitrine-ajout button:hover { border-color: #ff5a1f; }

    #liste .vitrine-carte {
      display: grid;
      grid-template-columns: 88px 1fr auto;
      gap: 1.25rem;
      align-items: start;
      border: 1px solid #26262b;
      border-radius: 0.5rem;
      background: #131316;
      padding: 1.25rem;
      margin-bottom: 1rem;
    }
    #liste .vitrine-photo {
      width: 88px;
      height: 88px;
      object-fit: cover;
      border-radius: 0.35rem;
      border: 1px solid #26262b;
      background: #1c1c20;
    }
    #liste .vitrine-titre { margin: 0 0 0.9rem; font-size: 0.95rem; }
    #liste label {
      display: block;
      font-size: 0.78rem;
      color: #a9a9b2;
      margin-bottom: 0.3rem;
    }
    #liste input {
      display: block;
      width: 100%;
      padding: 0.5rem 0.7rem;
      margin: 0 0 0.85rem;
      border: 1px solid #26262b;
      border-radius: 0.35rem;
      background: #1c1c20;
      color: #f3f1ec;
      font: inherit;
      font-size: 0.88rem;
    }
    #liste input:last-of-type { margin-bottom: 0; }
    #liste .vitrine-actions { display: flex; flex-direction: column; gap: 0.4rem; }
    #liste .vitrine-actions button {
      padding: 0.45rem 0.8rem;
      border-radius: 0.35rem;
      border: 1px solid #26262b;
      background: transparent;
      color: #f3f1ec;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
    }
    #liste .vitrine-actions button:hover:not(:disabled) { border-color: #ff5a1f; }
    #liste .vitrine-actions button:disabled { opacity: 0.35; cursor: not-allowed; }
    #liste .vitrine-lien { color: #ff7a45; margin-left: 0.5rem; }
    @media (max-width: 40rem) {
      #liste .vitrine-carte { grid-template-columns: 64px 1fr; }
      #liste .vitrine-photo { width: 64px; height: 64px; }
      #liste .vitrine-actions { grid-column: 1 / -1; flex-direction: row; }
    }
  </style>

  <script is:inline define:vars={{ selection }}>
    const liste = document.getElementById("liste");
    const etat = document.getElementById("etat");
    let items = selection.slice();

    function echapper(v) {
      return String(v).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
    }

    function rendre() {
      liste.innerHTML = items
        .map(
          (it, n) => `
        <div class="vitrine-carte">
          <img class="vitrine-photo" src="${echapper(it.image)}" alt="" width="88" height="88" />
          <div>
            <p class="vitrine-titre"><strong>${echapper(it.code)}</strong>
              <span class="muted">— ${echapper(it.family || "?")}</span>
              ${it.manquant ? '<span style="color:#ff5a1f"> · référence absente du catalogue</span>' : ""}
              <a class="vitrine-lien" href="/admin/catalogue/${encodeURIComponent(it.code)}">changer les photos</a>
            </p>
            <label for="t-${n}">Étiquette (courte, affichée sur la photo)</label>
            <input id="t-${n}" data-champ="tendance" data-n="${n}" maxlength="40" value="${echapper(it.tendance)}" placeholder="Deep concave" />
            <label for="a-${n}">Argument (une phrase, sous le prix)</label>
            <input id="a-${n}" data-champ="argument" data-n="${n}" maxlength="200" value="${echapper(it.argument)}" placeholder="Le dessin qui fait le plus gros volume du marché." />
          </div>
          <div class="vitrine-actions">
            <button type="button" data-monter="${n}" ${n === 0 ? "disabled" : ""}>↑ Monter</button>
            <button type="button" data-descendre="${n}" ${n === items.length - 1 ? "disabled" : ""}>↓ Descendre</button>
            <button type="button" data-retirer="${n}">Retirer</button>
          </div>
        </div>`
        )
        .join("");
      etat.textContent = `${items.length} jante${items.length > 1 ? "s" : ""} en vitrine.`;
    }

    liste.addEventListener("input", (e) => {
      const champ = e.target.dataset.champ;
      if (champ) items[Number(e.target.dataset.n)][champ] = e.target.value;
    });

    liste.addEventListener("click", (e) => {
      const b = e.target.closest("button");
      if (!b) return;
      const permuter = (i, j) => { [items[i], items[j]] = [items[j], items[i]]; };
      if (b.dataset.monter !== undefined) permuter(Number(b.dataset.monter), Number(b.dataset.monter) - 1);
      else if (b.dataset.descendre !== undefined) permuter(Number(b.dataset.descendre), Number(b.dataset.descendre) + 1);
      else if (b.dataset.retirer !== undefined) items.splice(Number(b.dataset.retirer), 1);
      else return;
      rendre();
    });

    document.getElementById("btn-ajouter").addEventListener("click", () => {
      const sel = document.getElementById("ajout");
      const code = sel.value;
      if (!code) return;
      if (items.some((i) => i.code === code)) { etat.textContent = `${code} est déjà en vitrine.`; return; }
      if (items.length >= 12) { etat.textContent = "Douze jantes au maximum."; return; }
      const opt = sel.selectedOptions[0];
      items.push({ code, tendance: "", argument: "", image: opt.dataset.image, family: opt.dataset.family, manquant: false });
      sel.value = "";
      rendre();
    });

    document.getElementById("btn-enregistrer").addEventListener("click", async (e) => {
      e.target.disabled = true;
      etat.textContent = "Enregistrement…";
      try {
        const res = await fetch("/api/admin/vitrine", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            items: items.map((i) => ({ code: i.code, tendance: i.tendance, argument: i.argument })),
          }),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || "Échec de l'enregistrement.");
        etat.textContent = `Vitrine enregistrée — ${json.count} jante${json.count > 1 ? "s" : ""} en ligne.`;
      } catch (err) {
        etat.textContent = err.message;
      } finally {
        e.target.disabled = false;
      }
    });

    rendre();
  </script>
</AdminLayout>
