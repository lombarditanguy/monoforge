---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Nouveau client">
  <h1>Nouveau client</h1>
  <div class="card">
    <form method="POST" action="/api/admin/clients">
      <label for="nom">Nom / raison sociale *</label>
      <input id="nom" name="nom" required />

      <div class="field-row">
        <div>
          <label for="email">Email</label>
          <input id="email" name="email" type="email" />
        </div>
        <div>
          <label for="telephone">Téléphone</label>
          <input id="telephone" name="telephone" />
        </div>
      </div>

      <label for="adresse">Adresse</label>
      <textarea id="adresse" name="adresse" rows="3"></textarea>

      <label for="notes">Notes</label>
      <textarea id="notes" name="notes" rows="3"></textarea>

      <button class="btn" type="submit">Créer le client</button>
    </form>
  </div>
</AdminLayout>
