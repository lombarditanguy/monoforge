---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import { initSchema } from "../../lib/db.js";

let result = null;
let error = null;

if (Astro.request.method === "POST") {
  try {
    await initSchema();
    result = "Tables créées ou déjà à jour.";
  } catch (err) {
    error = err.message;
  }
}
---

<AdminLayout title="Initialisation base de données">
  <h1>Initialisation de la base de données</h1>
  <div class="card">
    <p class="muted">
      À faire une seule fois, après avoir activé une base Postgres (Neon) dans le dashboard Vercel du
      projet et redéployé. Ce bouton crée les tables nécessaires (clients, factures, prix) si elles
      n'existent pas encore — sans risque de perte de données si elles existent déjà.
    </p>
    {result && <p style="color:#4ade80">{result}</p>}
    {error && <p class="error" style="color:#ff5a1f">{error}</p>}
    <form method="POST">
      <button class="btn" type="submit">Initialiser / vérifier les tables</button>
    </form>
  </div>
</AdminLayout>
