---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { sql } from "../../../lib/db.js";

const { id } = Astro.params;
let commande = null;
let dbError = null;
try {
  const rows = await sql`select * from commandes where id = ${Number(id)} limit 1`;
  commande = rows[0] || null;
} catch (err) {
  dbError = err.message;
}
if (!dbError && !commande) return Astro.redirect("/admin/commandes", 302);

const STATUTS = [
  { value: "en_attente_paiement", label: "En attente de paiement" },
  { value: "payee", label: "Payée" },
  { value: "expediee", label: "Expédiée" },
  { value: "annulee", label: "Annulée" },
];

// Montes d'origine relevées au moment de la commande. Le déport proposé n'est
// jamais écrit dans `deport` : c'est l'atelier qui valide, et cette séparation
// rend visible ce qui a été proposé par le calcul et ce qui a été décidé.
const monte = commande?.monte_origine || null;
const proposition = monte?.proposition || null;
const propositions = proposition
  ? [
      { cote: proposition.decale ? "Avant" : null, detail: proposition.avant },
      ...(proposition.decale ? [{ cote: "Arrière", detail: proposition.arriere }] : []),
    ].filter((p) => p.detail)
  : [];
---

<AdminLayout title={commande ? commande.reference : "Commande"}>
  {dbError && <div class="notice">{dbError}</div>}
  {commande && (
    <>
      <h1>{commande.reference}</h1>
      <p class="muted" style="margin-top:-1rem">Créée le {new Date(commande.created_at).toLocaleString("fr-FR")}</p>

      <div class="card">
        <h2 style="margin-top:0">Statut</h2>
        <form method="POST" action="/api/admin/commandes">
          <input type="hidden" name="id" value={commande.id} />
          <div class="field-row">
            <div>
              <label for="statut">Statut de la commande</label>
              <select id="statut" name="statut">
                {STATUTS.map((s) => <option value={s.value} selected={s.value === commande.statut}>{s.label}</option>)}
              </select>
            </div>
          </div>
          <button class="btn" type="submit">Mettre à jour</button>
        </form>
      </div>

      <div class="card">
        <h2 style="margin-top:0">Produit</h2>
        <table>
          <tbody>
            <tr><th>Référence jante</th><td>{commande.item_code} ({commande.item_family})</td></tr>
            <tr><th>Diamètre</th><td>{commande.taille || "—"}</td></tr>
            <tr><th>Largeur</th><td>{commande.largeur || "—"}</td></tr>
            <tr><th>Finition</th><td>{commande.finition || "—"}</td></tr>
            {commande.peinture_ral && (
              <tr>
                <th>Peinture</th>
                <td>
                  <span style={`display:inline-block;width:1.1rem;height:1.1rem;border-radius:.2rem;vertical-align:-3px;margin-right:.5rem;border:1px solid #26262b;background:${commande.peinture_hex || "#000"}`}></span>
                  <strong>RAL {commande.peinture_ral}</strong>
                  {commande.peinture_nom ? ` — ${commande.peinture_nom}` : ""}
                  {commande.peinture_aspect ? ` · aspect ${commande.peinture_aspect}` : ""}
                </td>
              </tr>
            )}
            <tr><th>Quantité</th><td>{commande.quantite}</td></tr>
            <tr><th>Prix unitaire HT</th><td>{Number(commande.prix_unitaire_ht).toFixed(2)} €</td></tr>
            <tr><th>Total HT</th><td><strong>{Number(commande.total_ht).toFixed(2)} €</strong></td></tr>
          </tbody>
        </table>
      </div>

      <div class="card">
        <h2 style="margin-top:0">Véhicule</h2>
        <table>
          <tbody>
            <tr><th>Plaque d'immatriculation</th><td>{commande.plaque_immatriculation || "—"}</td></tr>
            <tr>
              <th>Véhicule annoncé par le client</th>
              <td>
                {commande.vehicule_marque
                  ? `${commande.vehicule_marque} ${commande.vehicule_modele || ""} ${commande.vehicule_annee || ""}`.trim()
                  : "— (non vérifié à la commande)"}
              </td>
            </tr>
            {commande.vehicule_finition && (
              <tr><th>Version</th><td>{commande.vehicule_finition}</td></tr>
            )}
          </tbody>
        </table>

        <div style="margin:1rem 0;display:flex;align-items:center;gap:.75rem">
          <button type="button" id="mf-lookup-btn" class="btn btn-outline">Rechercher via l'API</button>
          <span id="mf-lookup-status" class="muted"></span>
        </div>

        <form method="POST" action="/api/admin/commandes">
          <input type="hidden" name="id" value={commande.id} />
          <div class="field-row">
            <div>
              <label for="vehicule_marque">Marque</label>
              <input id="vehicule_marque" name="vehicule_marque" type="text" value={commande.vehicule_marque || ""} />
            </div>
            <div>
              <label for="vehicule_modele">Modèle</label>
              <input id="vehicule_modele" name="vehicule_modele" type="text" value={commande.vehicule_modele || ""} />
            </div>
          </div>
          <div class="field-row">
            <div>
              <label for="entraxe">Entraxe</label>
              <input id="entraxe" name="entraxe" type="text" value={commande.entraxe || ""} placeholder="ex : 5x112" />
            </div>
            <div>
              <label for="deport">Déport</label>
              <input id="deport" name="deport" type="text" value={commande.deport || ""} placeholder="ex : ET35" />
            </div>
            <div>
              <label for="alesage">Alésage central</label>
              <input id="alesage" name="alesage" type="text" value={commande.alesage || ""} placeholder="ex : 66,6 mm" />
            </div>
          </div>
          <button class="btn" type="submit">Enregistrer</button>
        </form>

        {commande.vehicule_lookup_raw && (
          <details style="margin-top:1rem">
            <summary class="muted" style="cursor:pointer">Réponse brute de la dernière recherche (debug)</summary>
            <pre style="white-space:pre-wrap;font-size:.75rem;overflow-x:auto;background:#0a0a0b;padding:.75rem;border-radius:.3rem">{JSON.stringify(commande.vehicule_lookup_raw, null, 2)}</pre>
          </details>
        )}
      </div>

      <div class="card">
        <h2 style="margin-top:0">Emplacement de la jante (données constructeur)</h2>
        {proposition ? (
          <>
            {proposition.resume && (
              <p style="margin-top:0">
                Déport proposé : <strong style="font-size:1.15rem">{proposition.resume}</strong>
                <span class="muted"> — fiabilité {proposition.confiance}</span>
              </p>
            )}
            {proposition.alesage != null && (
              <p style="margin-top:0">
                Alésage central : <strong style="font-size:1.15rem">{String(proposition.alesage).replace(".", ",")} mm</strong>
                <span class="muted"> — cote du moyeu, indépendante de la taille commandée</span>
              </p>
            )}
            {proposition.alesagesConcurrents && (
              <div class="notice" style="margin:.75rem 0">
                <strong>Alésage à confirmer.</strong> Le jeu de données donne plusieurs valeurs pour ce véhicule
                ({proposition.alesagesConcurrents.join(" / ")} mm) — c'est anormal pour une cote de moyeu. À vérifier
                avant usinage.
              </div>
            )}
            {proposition.extrapole && (
              <div class="notice" style="margin:.75rem 0">
                <strong>Déport extrapolé.</strong> Aucune taille référencée ne correspond exactement à la commande :
                la valeur ci-dessus est reprise de la taille la plus proche, avec l'écart chiffré ci-dessous.
              </div>
            )}
            {proposition.ambigu && (
              <div class="notice" style="margin:.75rem 0">
                <strong>Plusieurs déports possibles.</strong> Cette taille est référencée avec des déports différents
                selon la version exacte du véhicule. Le détail ci-dessous les liste — à trancher avec le client avant
                fabrication.
              </div>
            )}
            {proposition.horsSerie && (
              <div class="notice" style="margin:.75rem 0">
                <strong>Taille au-dessus de la monte de série.</strong> Le déport vient du fichier constructeur, mais
                ce diamètre n'était pas monté d'usine sur ce véhicule — le passage de roue est à vérifier avec le
                client. C'est un point distinct de l'extrapolation : ici la cote est juste, c'est le montage qui
                demande un contrôle.
              </div>
            )}
            {propositions.map((p) => (
              <p class="muted" style="margin:.4rem 0">
                {p.cote && <strong>{p.cote} — </strong>}
                {p.detail.note}
              </p>
            ))}
            <div style="display:flex;gap:.75rem;align-items:center;margin-top:1rem;flex-wrap:wrap">
              <button
                type="button"
                id="mf-reprendre-deport"
                class="btn btn-outline"
                data-deport={propositions.length === 1 ? `ET${propositions[0].detail.deport}` : proposition.resume}
              >
                Reprendre dans le champ Déport
              </button>
              <span id="mf-reprendre-status" class="muted"></span>
            </div>
          </>
        ) : (
          <p class="muted" style="margin-top:0">
            Aucune monte d'origine trouvée pour ce véhicule{monte?.note ? ` — ${monte.note}` : "."} Le déport se
            renseigne à la main ci-dessus, comme avant. Si le jeu de données constructeur vient d'être chargé, relance
            la recherche avec le bouton « Rechercher via l'API ».
          </p>
        )}

        {monte?.montes?.length > 0 && (
          <details style="margin-top:1rem">
            <summary class="muted" style="cursor:pointer">
              Montes d'origine référencées ({monte.montes.length})
            </summary>
            <table style="margin-top:.5rem">
              <tbody>
                <tr><th>Version</th><th>Nature</th><th>Essieu</th><th>Diamètre</th><th>Largeur</th><th>Déport</th><th>Entraxe</th><th>Alésage</th></tr>
                {monte.montes.slice(0, 40).map((m) => (
                  <tr>
                    <td>{m.finition || "—"}</td>
                    <td>{{ 1: "série", 2: "taille sup.", 3: "très grande" }[m.groupe] || "—"}</td>
                    <td>{m.essieu === "arriere" ? "arrière" : m.essieu === "avant" ? "avant" : "les 4"}</td>
                    <td>{m.diametre ?? "—"}</td>
                    <td>{m.largeur ?? "—"}</td>
                    <td>{m.deport === null || m.deport === undefined ? "—" : `ET${m.deport}`}</td>
                    <td>{m.entraxe || "—"}</td>
                    <td>{m.alesage == null ? "—" : `${String(m.alesage).replace(".", ",")} mm`}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            {monte.trace?.length > 0 && (
              <p class="muted" style="font-size:.8rem;margin-top:.5rem">{monte.trace.join(" · ")}</p>
            )}
          </details>
        )}
      </div>

      <div class="card">
        <h2 style="margin-top:0">Client</h2>
        <table>
          <tbody>
            <tr><th>Nom</th><td>{commande.client_nom}</td></tr>
            <tr><th>Email</th><td>{commande.client_email}</td></tr>
            <tr><th>Téléphone</th><td>{commande.client_telephone || "—"}</td></tr>
          </tbody>
        </table>
      </div>

      <div class="field-row">
        <div class="card">
          <h2 style="margin-top:0">Adresse de livraison</h2>
          <p>
            {commande.livraison_rue}<br />
            {commande.livraison_complement && <>{commande.livraison_complement}<br /></>}
            {commande.livraison_code_postal} {commande.livraison_ville}<br />
            {commande.livraison_pays}
          </p>
        </div>
        <div class="card">
          <h2 style="margin-top:0">Adresse de facturation</h2>
          <p>
            {commande.facturation_rue}<br />
            {commande.facturation_complement && <>{commande.facturation_complement}<br /></>}
            {commande.facturation_code_postal} {commande.facturation_ville}<br />
            {commande.facturation_pays}
          </p>
        </div>
      </div>

      {(commande.stripe_session_id || commande.stripe_payment_intent) && (
        <div class="card">
          <h2 style="margin-top:0">Paiement Stripe</h2>
          <table>
            <tbody>
              {commande.stripe_session_id && <tr><th>Session</th><td>{commande.stripe_session_id}</td></tr>}
              {commande.stripe_payment_intent && <tr><th>Payment intent</th><td>{commande.stripe_payment_intent}</td></tr>}
            </tbody>
          </table>
        </div>
      )}

      <a href="/admin/commandes" class="btn btn-outline">← Retour aux commandes</a>
    </>
  )}

  <script define:vars={{ commandeId: commande?.id }}>
    // Le déport proposé n'écrase jamais le champ tout seul : la reprise est un
    // geste explicite de l'atelier, et il reste à enregistrer.
    const reprendreBtn = document.getElementById("mf-reprendre-deport");
    reprendreBtn?.addEventListener("click", () => {
      const champ = document.getElementById("deport");
      if (!champ) return;
      champ.value = reprendreBtn.dataset.deport || "";
      const status = document.getElementById("mf-reprendre-status");
      if (status) status.textContent = "Reporté — pense à enregistrer.";
    });

    const lookupBtn = document.getElementById("mf-lookup-btn");
    const lookupStatus = document.getElementById("mf-lookup-status");
    lookupBtn?.addEventListener("click", async () => {
      if (lookupStatus) lookupStatus.textContent = "Recherche en cours...";
      lookupBtn.setAttribute("disabled", "true");
      try {
        const res = await fetch("/api/admin/commandes/lookup-vehicule", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: commandeId }),
        });
        // Une fonction qui plante peut renvoyer un corps vide ou du HTML :
        // on lit d'abord en texte pour toujours afficher quelque chose d'utile.
        const body = await res.text();
        let json = null;
        try {
          json = body ? JSON.parse(body) : null;
        } catch {
          json = null;
        }
        if (!res.ok || !json) {
          throw new Error(
            json?.error || (body ? `Réponse inattendue du serveur (HTTP ${res.status}).` : `Le serveur n'a rien renvoyé (HTTP ${res.status}) — vérifie /admin/setup.`)
          );
        }

        const marqueInput = document.getElementById("vehicule_marque");
        const modeleInput = document.getElementById("vehicule_modele");
        const entraxeInput = document.getElementById("entraxe");
        const deportInput = document.getElementById("deport");
        if (marqueInput) marqueInput.value = json.marque || "";
        if (modeleInput) modeleInput.value = json.modele || "";
        if (json.entraxe && entraxeInput) entraxeInput.value = json.entraxe;
        if (json.deport && deportInput) deportInput.value = json.deport;

        if (lookupStatus) {
          const vehicule = `${json.marque || "?"} ${json.modele || ""} ${json.annee || ""}`.trim();
          const origine = json.source === "api" ? "via l'API" : "table interne";
          const parts = [`Véhicule : ${vehicule}${json.finition ? ` — ${json.finition}` : ""}.`];
          if (json.entraxe) parts.push(`Entraxe ${json.entraxe} (${origine}).`);
          if (json.confiance && json.confiance !== "haute") parts.push(`Fiabilité ${json.confiance} — à confirmer.`);
          if (json.fitmentError) parts.push(json.fitmentError);
          if (json.deportPropose) {
            parts.push(
              `Déport d'origine : ${json.deportPropose} (fiabilité ${json.deportConfiance}${json.deportVerification ? ", à valider" : ""}) — recharge la page pour le détail.`
            );
          } else if (!json.deport) {
            parts.push(json.oeNote || "Déport non récupéré — à renseigner ici avant fabrication.");
          }
          parts.push("Vérifie puis enregistre.");
          lookupStatus.textContent = parts.join(" ");
        }
      } catch (err) {
        if (lookupStatus) lookupStatus.textContent = `Erreur : ${err.message}`;
      } finally {
        lookupBtn.removeAttribute("disabled");
      }
    });
  </script>
</AdminLayout>
