---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { sql } from "../../../lib/db.js";

const { id } = Astro.params;
let commande = null;
let dbError = null;
try {
  const rows = await sql`select * from commandes where id = ${Number(id)} limit 1`;
  commande = rows[0] || null;
} catch (err) {
  dbError = err.message;
}
if (!dbError && !commande) return Astro.redirect("/admin/commandes", 302);

const STATUTS = [
  { value: "en_attente_paiement", label: "En attente de paiement" },
  { value: "payee", label: "Payée" },
  { value: "expediee", label: "Expédiée" },
  { value: "annulee", label: "Annulée" },
];
---

<AdminLayout title={commande ? commande.reference : "Commande"}>
  {dbError && <div class="notice">{dbError}</div>}
  {commande && (
    <>
      <h1>{commande.reference}</h1>
      <p class="muted" style="margin-top:-1rem">Créée le {new Date(commande.created_at).toLocaleString("fr-FR")}</p>

      <div class="card">
        <h2 style="margin-top:0">Statut</h2>
        <form method="POST" action="/api/admin/commandes">
          <input type="hidden" name="id" value={commande.id} />
          <div class="field-row">
            <div>
              <label for="statut">Statut de la commande</label>
              <select id="statut" name="statut">
                {STATUTS.map((s) => <option value={s.value} selected={s.value === commande.statut}>{s.label}</option>)}
              </select>
            </div>
          </div>
          <button class="btn" type="submit">Mettre à jour</button>
        </form>
      </div>

      <div class="card">
        <h2 style="margin-top:0">Produit</h2>
        <table>
          <tbody>
            <tr><th>Référence jante</th><td>{commande.item_code} ({commande.item_family})</td></tr>
            <tr><th>Diamètre</th><td>{commande.taille || "—"}</td></tr>
            <tr><th>Largeur</th><td>{commande.largeur || "—"}</td></tr>
            <tr><th>Finition</th><td>{commande.finition || "—"}</td></tr>
            <tr><th>Quantité</th><td>{commande.quantite}</td></tr>
            <tr><th>Prix unitaire HT</th><td>{Number(commande.prix_unitaire_ht).toFixed(2)} €</td></tr>
            <tr><th>Total HT</th><td><strong>{Number(commande.total_ht).toFixed(2)} €</strong></td></tr>
          </tbody>
        </table>
      </div>

      <div class="card">
        <h2 style="margin-top:0">Véhicule</h2>
        <table>
          <tbody>
            <tr><th>Plaque d'immatriculation</th><td>{commande.plaque_immatriculation || "—"}</td></tr>
            <tr>
              <th>Véhicule annoncé par le client</th>
              <td>
                {commande.vehicule_marque
                  ? `${commande.vehicule_marque} ${commande.vehicule_modele || ""}`.trim()
                  : "— (non vérifié à la commande)"}
              </td>
            </tr>
          </tbody>
        </table>

        <div style="margin:1rem 0;display:flex;align-items:center;gap:.75rem">
          <button type="button" id="mf-lookup-btn" class="btn btn-outline">Rechercher via l'API</button>
          <span id="mf-lookup-status" class="muted"></span>
        </div>

        <form method="POST" action="/api/admin/commandes">
          <input type="hidden" name="id" value={commande.id} />
          <div class="field-row">
            <div>
              <label for="vehicule_marque">Marque</label>
              <input id="vehicule_marque" name="vehicule_marque" type="text" value={commande.vehicule_marque || ""} />
            </div>
            <div>
              <label for="vehicule_modele">Modèle</label>
              <input id="vehicule_modele" name="vehicule_modele" type="text" value={commande.vehicule_modele || ""} />
            </div>
          </div>
          <div class="field-row">
            <div>
              <label for="entraxe">Entraxe</label>
              <input id="entraxe" name="entraxe" type="text" value={commande.entraxe || ""} placeholder="ex : 5x112" />
            </div>
            <div>
              <label for="deport">Déport</label>
              <input id="deport" name="deport" type="text" value={commande.deport || ""} placeholder="ex : ET35" />
            </div>
          </div>
          <button class="btn" type="submit">Enregistrer</button>
        </form>

        {commande.vehicule_lookup_raw && (
          <details style="margin-top:1rem">
            <summary class="muted" style="cursor:pointer">Réponse brute de la dernière recherche (debug)</summary>
            <pre style="white-space:pre-wrap;font-size:.75rem;overflow-x:auto;background:#0a0a0b;padding:.75rem;border-radius:.3rem">{JSON.stringify(commande.vehicule_lookup_raw, null, 2)}</pre>
          </details>
        )}
      </div>

      <div class="card">
        <h2 style="margin-top:0">Client</h2>
        <table>
          <tbody>
            <tr><th>Nom</th><td>{commande.client_nom}</td></tr>
            <tr><th>Email</th><td>{commande.client_email}</td></tr>
            <tr><th>Téléphone</th><td>{commande.client_telephone || "—"}</td></tr>
          </tbody>
        </table>
      </div>

      <div class="field-row">
        <div class="card">
          <h2 style="margin-top:0">Adresse de livraison</h2>
          <p>
            {commande.livraison_rue}<br />
            {commande.livraison_complement && <>{commande.livraison_complement}<br /></>}
            {commande.livraison_code_postal} {commande.livraison_ville}<br />
            {commande.livraison_pays}
          </p>
        </div>
        <div class="card">
          <h2 style="margin-top:0">Adresse de facturation</h2>
          <p>
            {commande.facturation_rue}<br />
            {commande.facturation_complement && <>{commande.facturation_complement}<br /></>}
            {commande.facturation_code_postal} {commande.facturation_ville}<br />
            {commande.facturation_pays}
          </p>
        </div>
      </div>

      {(commande.stripe_session_id || commande.stripe_payment_intent) && (
        <div class="card">
          <h2 style="margin-top:0">Paiement Stripe</h2>
          <table>
            <tbody>
              {commande.stripe_session_id && <tr><th>Session</th><td>{commande.stripe_session_id}</td></tr>}
              {commande.stripe_payment_intent && <tr><th>Payment intent</th><td>{commande.stripe_payment_intent}</td></tr>}
            </tbody>
          </table>
        </div>
      )}

      <a href="/admin/commandes" class="btn btn-outline">← Retour aux commandes</a>
    </>
  )}

  <script define:vars={{ commandeId: commande?.id }}>
    const lookupBtn = document.getElementById("mf-lookup-btn");
    const lookupStatus = document.getElementById("mf-lookup-status");
    lookupBtn?.addEventListener("click", async () => {
      if (lookupStatus) lookupStatus.textContent = "Recherche en cours...";
      lookupBtn.setAttribute("disabled", "true");
      try {
        const res = await fetch("/api/admin/commandes/lookup-vehicule", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: commandeId }),
        });
        // Une fonction qui plante peut renvoyer un corps vide ou du HTML :
        // on lit d'abord en texte pour toujours afficher quelque chose d'utile.
        const body = await res.text();
        let json = null;
        try {
          json = body ? JSON.parse(body) : null;
        } catch {
          json = null;
        }
        if (!res.ok || !json) {
          throw new Error(
            json?.error || (body ? `Réponse inattendue du serveur (HTTP ${res.status}).` : `Le serveur n'a rien renvoyé (HTTP ${res.status}) — vérifie /admin/setup.`)
          );
        }

        const marqueInput = document.getElementById("vehicule_marque");
        const modeleInput = document.getElementById("vehicule_modele");
        const entraxeInput = document.getElementById("entraxe");
        const deportInput = document.getElementById("deport");
        if (marqueInput) marqueInput.value = json.marque || "";
        if (modeleInput) modeleInput.value = json.modele || "";
        if (json.entraxe && entraxeInput) entraxeInput.value = json.entraxe;
        if (json.deport && deportInput) deportInput.value = json.deport;

        if (lookupStatus) {
          const vehicule = `${json.marque || "?"} ${json.modele || ""} ${json.annee || ""}`.trim();
          const origine = json.source === "api" ? "via l'API" : "table interne";
          const parts = [`Véhicule : ${vehicule}.`];
          if (json.entraxe) parts.push(`Entraxe ${json.entraxe} (${origine}).`);
          if (json.confiance && json.confiance !== "haute") parts.push(`Fiabilité ${json.confiance} — à confirmer.`);
          if (json.fitmentError) parts.push(json.fitmentError);
          if (!json.deport) parts.push("Déport non récupéré — à renseigner ici avant fabrication.");
          parts.push("Vérifie puis enregistre.");
          lookupStatus.textContent = parts.join(" ");
        }
      } catch (err) {
        if (lookupStatus) lookupStatus.textContent = `Erreur : ${err.message}`;
      } finally {
        lookupBtn.removeAttribute("disabled");
      }
    });
  </script>
</AdminLayout>
