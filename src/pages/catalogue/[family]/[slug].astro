---
export const prerender = false;
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import WheelPhotoCard from "../../../components/WheelPhotoCard.astro";
import CTASection from "../../../components/CTASection.astro";
import ColorConfigurator from "../../../components/ColorConfigurator.astro";
import { FAMILIES } from "../../../data/catalog.js";
import { getCatalogItem, listItemsForFamily } from "../../../lib/catalogDb.js";
import { breadcrumbLd, catalogItemLd } from "../../../utils/seo.js";
import { sql } from "../../../lib/db.js";

const { family: familySlug, slug } = Astro.params;
const family = FAMILIES.find((f) => f.slug === familySlug);
if (!family) return Astro.redirect("/catalogue", 302);
const item = await getCatalogItem(familySlug, slug);
if (!item) return Astro.redirect("/catalogue", 302);
const gallery = item.images && item.images.length > 0 ? item.images : [item.image];

const siblings = (await listItemsForFamily(family.slug)).filter((i) => i.slug !== item.slug);
const related = siblings.sort(() => 0.5 - Math.random()).slice(0, 6);

let itemPriceHt = 0;
let coefficientRevente = 0;
let sizes = [];
let widths = [];
let finishOptions = [];
try {
  const [priceRow] = await sql`select coefficient_revente from price_bases where famille = ${family.slug} limit 1`;
  const [itemPriceRow] = await sql`select prix_achat_ht from item_prices where code = ${item.code} limit 1`;
  coefficientRevente = Number(priceRow?.coefficient_revente || 0);
  itemPriceHt = Number(itemPriceRow?.prix_achat_ht || 0);
  sizes = await sql`select taille, coefficient from size_coefficients order by ordre asc, id asc`;
  widths = await sql`select largeur, coefficient from width_coefficients order by ordre asc, id asc`;
  finishOptions = await sql`select id, label, prix_achat_ht, coefficient_revente from finish_options where actif = true order by position asc, id asc`;
} catch {
  // Pas de base connectée / pas encore configurée : on retombe sur "prix sur devis".
}
const basePrice = itemPriceHt * coefficientRevente;
const hasPricing = basePrice > 0 && sizes.length > 0 && widths.length > 0;
const sizesData = sizes.map((s) => ({ taille: s.taille, coefficient: Number(s.coefficient) }));
const widthsData = widths.map((w) => ({ largeur: w.largeur, coefficient: Number(w.coefficient) }));
const finishesData = finishOptions.map((f) => ({
  id: f.id,
  label: f.label,
  supplement: Number(f.prix_achat_ht || 0) * Number(f.coefficient_revente || 0),
}));
const minSizeCoeff = hasPricing ? Math.min(...sizesData.map((s) => s.coefficient)) : 1;
const minWidthCoeff = hasPricing ? Math.min(...widthsData.map((w) => w.coefficient)) : 1;
const startingPrice = hasPricing ? basePrice * minSizeCoeff * minWidthCoeff : 0;

let relatedWithPrice = related.map((w) => ({ ...w, startingPrice: 0 }));
if (hasPricing && related.length > 0) {
  try {
    const relatedCodes = related.map((w) => w.code);
    const relatedPriceRows = await sql`select code, prix_achat_ht from item_prices where code = any(${relatedCodes})`;
    const relatedAchatByCode = new Map(relatedPriceRows.map((r) => [r.code, Number(r.prix_achat_ht || 0)]));
    relatedWithPrice = related.map((w) => ({
      ...w,
      startingPrice: (relatedAchatByCode.get(w.code) || 0) * coefficientRevente * minSizeCoeff * minWidthCoeff,
    }));
  } catch {
    // Pas de prix pour les références liées : les cartes retombent sur "sur devis".
  }
}

Astro.response.headers.set("Cache-Control", "public, s-maxage=600, stale-while-revalidate=86400");

const ld = [
  breadcrumbLd([
    { name: "Catalogue", path: "/catalogue" },
    { name: family.short, path: `/catalogue/${family.slug}` },
    { name: item.code, path: `/catalogue/${item.family}/${item.slug}` },
  ]),
  catalogItemLd(item, family),
];
---

<Layout
  title={`${item.code} — jante forgée ${family.short.toLowerCase()}`}
  description={`${item.code} : référence ${family.short.toLowerCase()} du catalogue KESSLER WHEELS. Fabriquée à la commande, sans stock — taille, largeur et déport définis pour votre véhicule.`}
  jsonLd={ld}
>
  <Breadcrumbs items={[{ name: "Catalogue", path: "/catalogue" }, { name: family.short, path: `/catalogue/${family.slug}` }, { name: item.code, path: `/catalogue/${item.family}/${item.slug}` }]} />

  <section class="container-mf grid grid-cols-1 gap-14 pb-20 pt-6 lg:grid-cols-2 lg:gap-20">
    <div class="lg:sticky lg:top-28 lg:h-fit">
      <div class="overflow-hidden rounded-lg border border-(--color-line) bg-(--color-surface-2)">
        <img id="mf-gallery-main" src={gallery[0]} alt={`Jante forgée ${item.code}`} width="600" height="600" class="aspect-square w-full object-cover" />
      </div>
      {gallery.length > 1 && (
        <div class="mt-3 grid grid-cols-3 gap-3">
          {gallery.map((src, i) => (
            <button
              type="button"
              data-gallery-thumb={src}
              class:list={["mf-thumb overflow-hidden rounded-md border bg-(--color-surface-2)", i === 0 ? "border-(--color-forge-500)" : "border-(--color-line)"]}
            >
              <img src={src} alt={`${item.code} — photo ${i + 1}`} width="200" height="200" class="aspect-square w-full object-cover" loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </div>

    <div>
      <p class="chip">{family.label}</p>
      <h1 class="mt-5 text-balance font-display text-3xl font-bold leading-tight text-(--color-paper) sm:text-4xl">{item.code}</h1>
      <p class="mt-6 max-w-lg leading-relaxed text-(--color-mist)">{family.description}</p>

      {hasPricing ? (
        <div class="mt-8 rounded-lg border border-(--color-line) bg-(--color-surface-2) p-5">
          <p class="text-xs uppercase tracking-widest text-(--color-fog)">Prix</p>
          <p id="mf-price-display" class="mt-1 font-display text-3xl font-bold text-(--color-paper)">
            {startingPrice.toFixed(0)} € HT
          </p>
          <form id="mf-checkout-form" method="GET" action="/commande/nouvelle">
            <input type="hidden" name="code" value={item.code} />
            <input type="hidden" name="family" value={family.slug} />
            <input type="hidden" name="slug" value={item.slug} />
            <input type="hidden" id="mf-hidden-size-label" name="sizeLabel" value={sizesData[0]?.taille} />
            <input type="hidden" id="mf-hidden-width-label" name="widthLabel" value={widthsData[0]?.largeur} />
            <input type="hidden" id="mf-hidden-finish-label" name="finishLabel" value="Brut forgé" />
            <input type="hidden" id="mf-hidden-qty" name="quantity" value="4" />
            <input type="hidden" id="mf-hidden-unit-price" name="unitPriceHt" value={startingPrice.toFixed(2)} />
            <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="mf-size-select" class="mb-1.5 block text-xs uppercase tracking-widest text-(--color-fog)">Diamètre</label>
                <select id="mf-size-select" class="w-full rounded-md border border-(--color-line) bg-(--color-surface) px-3 py-2 text-sm text-(--color-paper)">
                  {sizesData.map((s) => <option value={s.coefficient} data-label={s.taille}>{s.taille}</option>)}
                  <option value="" data-origine="1" data-label="Comme d'origine">Comme mes roues d'origine</option>
                </select>
              </div>
              <div>
                <label for="mf-width-select" id="mf-width-label" class="mb-1.5 block text-xs uppercase tracking-widest text-(--color-fog)">Largeur</label>
                <select id="mf-width-select" class="w-full rounded-md border border-(--color-line) bg-(--color-surface) px-3 py-2 text-sm text-(--color-paper)">
                  {widthsData.map((w) => <option value={w.coefficient} data-label={w.largeur}>{w.largeur}</option>)}
                  <option value="" data-origine="1" data-label="Comme d'origine">Comme mes roues d'origine</option>
                </select>
              </div>
              <div id="mf-width-rear-row" class="hidden">
                <label for="mf-width-rear-select" class="mb-1.5 block text-xs uppercase tracking-widest text-(--color-fog)">Largeur (arrière)</label>
                <select id="mf-width-rear-select" class="w-full rounded-md border border-(--color-line) bg-(--color-surface) px-3 py-2 text-sm text-(--color-paper)">
                  {widthsData.map((w) => <option value={w.coefficient} data-label={w.largeur}>{w.largeur}</option>)}
                  <option value="" data-origine="1" data-label="Comme d'origine">Comme mes roues d'origine</option>
                </select>
              </div>
              <div>
                <label for="mf-finish-select" class="mb-1.5 block text-xs uppercase tracking-widest text-(--color-fog)">Finition</label>
                <select id="mf-finish-select" class="w-full rounded-md border border-(--color-line) bg-(--color-surface) px-3 py-2 text-sm text-(--color-paper)">
                  <option value="0" data-label="Brut forgé">Brut forgé (aucune finition)</option>
                  {finishesData.map((f) => <option value={f.supplement} data-label={f.label} data-peinture={/peinture/i.test(f.label) ? "1" : undefined}>{f.label}{f.supplement > 0 ? ` (+${f.supplement.toFixed(0)} €)` : ""}</option>)}
                </select>
              </div>
              <div>
                <label for="mf-qty-select" class="mb-1.5 block text-xs uppercase tracking-widest text-(--color-fog)">Quantité</label>
                <select id="mf-qty-select" class="w-full rounded-md border border-(--color-line) bg-(--color-surface) px-3 py-2 text-sm text-(--color-paper)">
                  <option value="1">1 jante</option>
                  <option value="2">2 jantes</option>
                  <option value="4" selected>4 jantes (jeu complet)</option>
                </select>
              </div>
            </div>
            <ColorConfigurator />
            <button type="submit" id="mf-buy-btn" class="btn btn-forge mt-5 w-full sm:w-auto">Commander et payer</button>
          </form>
          <!-- Choisir « comme mes roues d'origine » rend le prix incalculable :
               la taille dépend du véhicule, qu'on ne connaît pas encore. On ne
               facture donc pas au hasard — on bascule sur l'étude, où la plaque
               donne les cotes d'origine et le prix exact. -->
          <a
            href={`/configurateur?ref=${encodeURIComponent(item.code)}`}
            id="mf-devis-btn"
            class="btn btn-forge mt-5 hidden w-full sm:w-auto"
          >Continuer avec ma plaque</a>
          <!-- La phrase posait la question sans donner la réponse : le bouton
               sur-mesure est plus bas, hors du regard de qui vient de lire. Le
               lien ferme la question là où elle est posée. -->
          <p class="mt-4 text-xs leading-relaxed text-(--color-fog)">
            Prix HT pour cette jante telle quelle. Besoin d'une finition, d'un dessin ou d'une contrainte technique
            particulière qui ne figure pas ici ?
            <a
              href={`/configurateur?ref=${encodeURIComponent(item.code)}`}
              class="font-semibold whitespace-nowrap text-(--color-forge-400) underline underline-offset-2 hover:text-(--color-forge-300)"
            >Faire mon projet sur mesure →</a>
          </p>
        </div>
      ) : null}

      <a href={`/configurateur?ref=${encodeURIComponent(item.code)}`} class="btn btn-outline mt-4 w-full sm:w-auto">
        Utiliser cette jante comme base pour mon projet sur-mesure
      </a>

      <div class="mt-10 border-t border-(--color-line) pt-8">
        <p class="text-xs uppercase tracking-widest text-(--color-fog)">Fabrication</p>
        <p class="mt-2 font-display text-lg font-bold text-(--color-paper)">Fabriquée spécialement pour votre véhicule</p>
        <p class="mt-2 max-w-lg text-sm leading-relaxed text-(--color-mist)">
          Aucun stock : diamètre, largeur et déport sont définis avec vous au moment de la commande, à partir de ce dessin (voir notre <a href="/journal/guide-choisir-taille-jantes" class="underline hover:text-(--color-mist)">guide sur les tailles</a>). Le nombre et la forme des bâtons peuvent eux-mêmes être adaptés si besoin — voir <a href="/sur-mesure" class="underline hover:text-(--color-mist)">le sur-mesure</a>.
        </p>
        {(family.slug === "monobloc" || family.slug === "multi-pieces") && (
          <p class="mt-2 max-w-lg text-sm leading-relaxed text-(--color-mist)">
            Voir notre comparatif <a href="/journal/monobloc-ou-multi-pieces" class="underline hover:text-(--color-mist)">monobloc vs multi-pièces</a> pour choisir l'architecture adaptée à votre projet.
          </p>
        )}
      </div>

      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        {!hasPricing && (
          <a href={`/configurateur?ref=${encodeURIComponent(item.code)}`} class="btn btn-forge">Demander cette référence</a>
        )}
        <a href={`/catalogue/${family.slug}`} class="btn btn-outline">Voir toute la famille {family.short}</a>
      </div>
      {!hasPricing && (
        <p class="mt-4 text-xs text-(--color-fog)">Fabrication à la demande — prix communiqué après étude technique, selon taille, dessin et finition.</p>
      )}
    </div>
  </section>

  <section class="container-mf py-20">
    <p class="section-label">Continuer d'explorer</p>
    <h2 class="mt-4 font-display text-2xl font-bold text-(--color-paper)">Autres références {family.short}</h2>
    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {relatedWithPrice.map((w) => <WheelPhotoCard item={w} startingPrice={w.startingPrice} />)}
    </div>
  </section>

  <CTASection
    title={`Envie d'une ${item.code} à votre taille exacte ?`}
    description="Envoyez-nous les cotes de votre véhicule, on s'occupe de l'adaptation technique."
    primaryHref={`/configurateur?ref=${encodeURIComponent(item.code)}`}
  />

  <script>
    const mainImg = document.getElementById("mf-gallery-main") as HTMLImageElement | null;
    document.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const src = btn.getAttribute("data-gallery-thumb");
        if (mainImg && src) mainImg.src = src;
        document.querySelectorAll(".mf-thumb").forEach((el) => {
          el.classList.remove("border-(--color-forge-500)");
          el.classList.add("border-(--color-line)");
        });
        btn.classList.remove("border-(--color-line)");
        btn.classList.add("border-(--color-forge-500)");
      });
    });
  </script>

  {hasPricing && (
    <script define:vars={{ basePrice }}>
      const sizeSelect = document.getElementById("mf-size-select");
      const widthSelect = document.getElementById("mf-width-select");
      const widthLabel = document.getElementById("mf-width-label");
      const widthRearRow = document.getElementById("mf-width-rear-row");
      const widthRearSelect = document.getElementById("mf-width-rear-select");
      const finishSelect = document.getElementById("mf-finish-select");
      const qtySelect = document.getElementById("mf-qty-select");
      const display = document.getElementById("mf-price-display");
      const hiddenSizeLabel = document.getElementById("mf-hidden-size-label");
      const hiddenWidthLabel = document.getElementById("mf-hidden-width-label");
      const hiddenFinishLabel = document.getElementById("mf-hidden-finish-label");
      const hiddenQty = document.getElementById("mf-hidden-qty");
      const hiddenUnitPrice = document.getElementById("mf-hidden-unit-price");

      function recompute() {
        const sizeCoeff = Number(sizeSelect?.value || 1);
        const widthCoeff = Number(widthSelect?.value || 1);
        const finishSupplement = Number(finishSelect?.value || 0);
        const qty = Number(qtySelect?.value || 1);
        const staggered = qty === 4;

        if (widthRearRow) widthRearRow.classList.toggle("hidden", !staggered);
        if (widthLabel) widthLabel.textContent = staggered ? "Largeur (avant)" : "Largeur";

        const frontUnit = basePrice * sizeCoeff * widthCoeff + finishSupplement;
        const frontLabel = widthSelect?.selectedOptions[0]?.dataset.label || "";

        let total = frontUnit * qty;
        let unitPrice = frontUnit;
        let widthLabelForForm = frontLabel;

        if (staggered) {
          const widthRearCoeff = Number(widthRearSelect?.value || widthCoeff);
          const rearUnit = basePrice * sizeCoeff * widthRearCoeff + finishSupplement;
          const rearLabel = widthRearSelect?.selectedOptions[0]?.dataset.label || "";
          total = 2 * frontUnit + 2 * rearUnit;
          unitPrice = total / qty;
          widthLabelForForm = rearLabel === frontLabel ? frontLabel : `${frontLabel} avant / ${rearLabel} arrière`;
        }

        // Une option « comme d'origine » ne porte pas de coefficient : le prix
        // ne peut pas être calculé, et afficher un chiffre serait mentir.
        const auxCotesOrigine = [sizeSelect, widthSelect, staggered ? widthRearSelect : null]
          .some((sel) => sel && sel.selectedOptions[0]?.dataset.origine === "1");
        const buyBtn = document.getElementById("mf-buy-btn");
        const devisBtn = document.getElementById("mf-devis-btn");
        buyBtn?.classList.toggle("hidden", auxCotesOrigine);
        devisBtn?.classList.toggle("hidden", !auxCotesOrigine);

        if (display) {
          display.textContent = auxCotesOrigine
            ? "Prix confirmé avec votre plaque"
            : `${total.toFixed(0)} € HT (${qty} jante${qty > 1 ? "s" : ""})`;
        }
        if (hiddenSizeLabel) hiddenSizeLabel.value = sizeSelect?.selectedOptions[0]?.dataset.label || "";
        if (hiddenWidthLabel) hiddenWidthLabel.value = widthLabelForForm;
        if (hiddenFinishLabel) hiddenFinishLabel.value = finishSelect?.selectedOptions[0]?.dataset.label || "";
        if (hiddenQty) hiddenQty.value = String(qty);
        if (hiddenUnitPrice) hiddenUnitPrice.value = unitPrice.toFixed(2);
      }
      // Le configurateur de couleur ne concerne que les finitions peinture :
      // on l'affiche à la demande, et on neutralise ses champs sinon pour ne
      // pas transmettre une couleur sur une jante brute ou polie.
      const colorPanel = document.getElementById("mf-color-panel");
      function syncColorPanel() {
        const isPeinture = finishSelect?.selectedOptions[0]?.dataset.peinture === "1";
        colorPanel?.classList.toggle("hidden", !isPeinture);
        colorPanel?.querySelectorAll("input").forEach((input) => {
          input.disabled = !isPeinture;
        });
      }

      sizeSelect?.addEventListener("change", recompute);
      widthSelect?.addEventListener("change", recompute);
      widthRearSelect?.addEventListener("change", recompute);
      finishSelect?.addEventListener("change", () => {
        recompute();
        syncColorPanel();
      });
      qtySelect?.addEventListener("change", recompute);
      recompute();
      syncColorPanel();
    </script>
  )}
</Layout>
