---
export const prerender = false;
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import WheelPhotoCard from "../../../components/WheelPhotoCard.astro";
import CTASection from "../../../components/CTASection.astro";
import { FAMILIES } from "../../../data/catalog.js";
import { listItemsForFamily } from "../../../lib/catalogDb.js";
import { breadcrumbLd } from "../../../utils/seo.js";
import { startingPrices } from "../../../lib/pricing.js";

const { family: familySlug } = Astro.params;
const family = FAMILIES.find((f) => f.slug === familySlug);
if (!family) return Astro.redirect("/catalogue", 302);
const items = await listItemsForFamily(family.slug);
// Famille entièrement retirée depuis l'admin : sa page n'a plus d'objet, et la
// laisser ouverte sur une grille vide laisserait croire à une panne.
if (items.length === 0) return Astro.redirect("/catalogue", 302);

const prix = await startingPrices(items);
const itemsWithPrice = items.map((i) => ({ ...i, startingPrice: prix.get(i.code) || 0 }));
const startingPrice = prix.size > 0 ? Math.min(...prix.values()) : 0;

// Dix minutes de cache, c'était trop long pour qui gère le catalogue :
// changer une photo dans l'admin et ne rien voir bouger sur le site pendant
// dix minutes ne se distingue pas d'un échec, et on recommence l'envoi. Une
// minute suffit à absorber les rafales, et la revalidation en tâche de fond
// est raccourcie d'autant — sinon une page pouvait rester vieille d'un jour.
//
// `max-age=0` vise le navigateur, pas le CDN : sans durée explicite il invente
// la sienne, et celui qui vient de changer une photo est justement celui qui
// recharge. Et pas de `stale-while-revalidate` : mesuré au navigateur, il
// autorise aussi le navigateur à servir la vieille page pendant toute sa durée
// pendant qu'il rafraîchit derrière. On retirait une jante de l'admin et la
// page continuait de l'afficher — le symptôme exact qu'on cherchait à corriger.
// Le CDN revalide donc franchement toutes les minutes ; c'est une requête par
// minute et par page, et c'est le prix d'un site qui dit la vérité.
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=60");

const STYLE_GROUPS = [
  { label: "Branches simples", tags: ["simple"] },
  { label: "Multi-branches / mesh", tags: ["multi"] },
];
const availableGroups = STYLE_GROUPS.map((g) => ({
  ...g,
  count: items.filter((i) => g.tags.includes(i.spokeStyle)).length,
})).filter((g) => g.count > 0);
---

<Layout
  title={`${family.label} — ${items.length} références de jantes forgées`}
  description={`${family.description} ${items.length} références en photo, fabriquées à la commande, toute taille sur demande.`}
  jsonLd={breadcrumbLd([{ name: "Catalogue", path: "/catalogue" }, { name: family.short, path: `/catalogue/${family.slug}` }])}
>
  <Breadcrumbs items={[{ name: "Catalogue", path: "/catalogue" }, { name: family.short, path: `/catalogue/${family.slug}` }]} />

  <section class="container-mf pb-12 pt-6">
    <p class="chip">{items.length} références{startingPrice > 0 ? ` · à partir de ${Math.round(startingPrice).toLocaleString("fr-FR")} € HT` : ""}</p>
    <h1 class="mt-6 max-w-2xl text-balance font-display text-4xl font-bold leading-tight text-(--color-paper) sm:text-5xl">
      {family.label}
    </h1>
    <p class="mt-5 max-w-2xl text-balance text-lg leading-relaxed text-(--color-mist)">{family.description}</p>
    <div class="mt-6 rounded-lg border border-(--color-forge-500)/30 bg-(--color-forge-500)/5 p-4 text-sm leading-relaxed text-(--color-mist)">
      <strong class="text-(--color-paper)">Aucune taille affichée ici volontairement.</strong> Ces photos montrent le dessin, pas un format figé : diamètre, largeur et déport sont définis avec vous au moment de la commande (voir notre <a href="/journal/guide-choisir-taille-jantes" class="underline hover:text-(--color-paper)">guide sur les tailles</a>). Aucun stock — chaque jeu est fabriqué spécialement pour votre véhicule.
    </div>
  </section>

  <section class="container-mf pb-10">
    {availableGroups.length > 1 && (
      <div class="mb-7">
        <p class="mb-3 text-xs uppercase tracking-widest text-(--color-fog)">Filtrer par style de branches</p>
        <div id="mf-style-filters" class="flex flex-wrap items-center gap-2">
          <button
            type="button"
            data-style-filter=""
            class="mf-style-chip is-active flex items-center gap-2 rounded-full border border-(--color-forge-500) bg-(--color-forge-500)/10 px-3.5 py-1.5 text-xs font-semibold text-(--color-paper) transition-colors"
          >
            Toutes
            <span class="text-(--color-fog)">{items.length}</span>
          </button>
          {availableGroups.map((g) => (
            <button
              type="button"
              data-style-filter={g.tags.join(",")}
              class="mf-style-chip flex items-center gap-2 rounded-full border border-(--color-line) bg-(--color-surface-2) px-3.5 py-1.5 text-xs font-semibold text-(--color-mist) transition-colors hover:border-(--color-forge-500)/50"
            >
              {g.label}
              <span class="text-(--color-fog)">{g.count}</span>
            </button>
          ))}
        </div>
      </div>
    )}
    <p id="mf-catalog-count" class="mb-4 text-sm text-(--color-fog)">{items.length} références affichées</p>
    <div id="mf-catalog-grid" class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
      {itemsWithPrice.map((item) => <WheelPhotoCard item={item} startingPrice={item.startingPrice} />)}
    </div>
    <p id="mf-catalog-empty" class="hidden py-16 text-center text-sm text-(--color-fog)">Aucune référence dans ce style pour l'instant.</p>
  </section>

  <script define:vars={{ total: items.length }}>
    const chips = Array.from(document.querySelectorAll("#mf-style-filters .mf-style-chip"));
    const grid = document.getElementById("mf-catalog-grid");
    const count = document.getElementById("mf-catalog-count");
    const empty = document.getElementById("mf-catalog-empty");
    if (grid) {
      const cards = Array.from(grid.querySelectorAll("[data-wheel-style]"));
      chips.forEach((chip) => {
        chip.addEventListener("click", () => {
          const tags = chip.dataset.styleFilter ? chip.dataset.styleFilter.split(",") : null;
          let visible = 0;
          for (const card of cards) {
            const match = !tags || tags.includes(card.dataset.wheelStyle);
            card.classList.toggle("hidden", !match);
            if (match) visible += 1;
          }
          chips.forEach((c) => {
            c.classList.toggle("is-active", c === chip);
            c.classList.toggle("border-(--color-forge-500)", c === chip);
            c.classList.toggle("bg-(--color-forge-500)/10", c === chip);
            c.classList.toggle("text-(--color-paper)", c === chip);
            c.classList.toggle("border-(--color-line)", c !== chip);
            c.classList.toggle("bg-(--color-surface-2)", c !== chip);
            c.classList.toggle("text-(--color-mist)", c !== chip);
          });
          if (count) count.textContent = tags ? `${visible} / ${total} références` : `${total} références affichées`;
          if (empty) empty.classList.toggle("hidden", visible !== 0);
          grid.classList.toggle("hidden", visible === 0);
        });
      });
    }
  </script>

  <CTASection
    title={`Une référence ${family.short} vous plaît ?`}
    description="Indiquez sa référence dans le configurateur : nous l'adaptons à la taille et au déport de votre véhicule."
  />
</Layout>
