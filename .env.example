# Copier en .env pour le développement local (jamais commité).
# Voir la section "Mise en route de l'espace admin" du README pour le détail.

# Fourni automatiquement par Vercel une fois la base Postgres (Neon) créée et liée au projet.
DATABASE_URL=

# Hash bcrypt du mot de passe admin — générer avec :
# node -e "console.log(require('bcryptjs').hashSync('TON_MOT_DE_PASSE', 10))"
ADMIN_PASSWORD_HASH=

# Chaîne aléatoire longue pour signer les sessions — générer avec : openssl rand -hex 32
ADMIN_SESSION_SECRET=
